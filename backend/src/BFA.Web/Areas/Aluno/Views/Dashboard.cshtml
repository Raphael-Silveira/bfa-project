@model DashboardAlunoViewModel
@{
    ViewData["Title"] = "Painel do Aluno";
    Layout = "_AlunoLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-painel-aluno">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Bem-vindo(a)</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-painel-aluno">@Model.NomeAluno</h1>
        <p class="bfa-admin-page-header__description">@Model.NomeUnidade</p>
    </div>
</header>

<section class="bfa-aluno-hero">
    <div class="bfa-aluno-hero__main">
        <p class="bfa-aluno-hero__eyebrow">Painel do aluno</p>
        <h2 class="bfa-aluno-hero__title">Resumo rápido da sua rotina</h2>
        <p class="bfa-aluno-hero__description">Acompanhe presença, agenda e cobranças em um único lugar.</p>
        <div class="bfa-aluno-hero__links">
            <a class="bfa-btn-primary bfa-admin-button"
               asp-area="Aluno" asp-controller="Aluno" asp-action="Agenda"
               asp-route-unidadeId="@Model.UnidadeId">Abrir agenda</a>
            <a class="bfa-btn-secondary bfa-admin-button"
               asp-area="Aluno" asp-controller="Aluno" asp-action="Financeiro"
               asp-route-unidadeId="@Model.UnidadeId">Ver financeiro</a>
        </div>
    </div>

    <div class="bfa-aluno-hero__summary bfa-admin-card">
        @if (Model.ProximaAula is not null)
        {
            <p class="bfa-aluno-hero__summary-label">Próxima aula</p>
            <strong>@Model.ProximaAula</strong>
        }
        else
        {
            <p class="bfa-aluno-hero__summary-label">Próxima aula</p>
            <strong>Nenhuma aula programada</strong>
            <span>Seu calendário será exibido aqui assim que houver aulas.</span>
        }
    </div>
</section>

<div class="bfa-admin-card-grid bfa-aluno-stats">
    <div class="bfa-admin-card bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__icon bfa-admin-metric-card__icon--accent">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20v-6"/><path d="M6 20v-2"/><path d="M18 20v-10"/><path d="M4 20h16"/></svg>
        </div>
        <div class="bfa-admin-metric-card__body">
            <span class="bfa-admin-metric-card__label">Frequência</span>
            <strong class="bfa-admin-metric-card__value">@Model.PercentualFrequencia</strong>
        </div>
    </div>
    <div class="bfa-admin-card bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/></svg>
        </div>
        <div class="bfa-admin-metric-card__body">
            <span class="bfa-admin-metric-card__label">Aulas (mês)</span>
            <strong class="bfa-admin-metric-card__value">@Model.TotalAulas</strong>
        </div>
    </div>
    <div class="bfa-admin-card bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__icon bfa-admin-metric-card__icon--danger">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
        </div>
        <div class="bfa-admin-metric-card__body">
            <span class="bfa-admin-metric-card__label">Pendente</span>
            <strong class="bfa-admin-metric-card__value bfa-admin-metric-card__value--danger">@Model.TotalPendente</strong>
        </div>
    </div>
</div>

<div class="bfa-admin-card bfa-aluno-shortcuts-card">
    <div class="bfa-aluno-shortcuts-card__header">
        <div>
            <p class="bfa-aluno-shortcuts-card__eyebrow">Atalhos</p>
            <h2 class="bfa-admin-card__title">Acessos rápidos</h2>
        </div>
    </div>
    <div class="bfa-admin-card-grid bfa-aluno-shortcuts-grid">
        <a class="bfa-btn-secondary bfa-admin-button" asp-area="Aluno" asp-controller="Aluno" asp-action="Matriculas" asp-route-unidadeId="@Model.UnidadeId">Matrículas</a>
        <a class="bfa-btn-secondary bfa-admin-button" asp-area="Aluno" asp-controller="Aluno" asp-action="Agenda" asp-route-unidadeId="@Model.UnidadeId">Agenda</a>
        <a class="bfa-btn-secondary bfa-admin-button" asp-area="Aluno" asp-controller="Aluno" asp-action="Frequencia" asp-route-unidadeId="@Model.UnidadeId">Frequência</a>
        <a class="bfa-btn-secondary bfa-admin-button" asp-area="Aluno" asp-controller="Aluno" asp-action="Financeiro" asp-route-unidadeId="@Model.UnidadeId">Financeiro</a>
    </div>
</div>

@section Styles {
<style>
    .bfa-aluno-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.75fr);
        gap: 1rem;
        padding: 1.25rem;
        border: 1px solid var(--bfa-border);
        border-radius: var(--radius-lg);
        background:
            radial-gradient(circle at top left, rgba(255, 193, 7, 0.1), transparent 18rem),
            linear-gradient(145deg, rgba(29, 32, 35, 0.98), rgba(21, 23, 25, 0.98));
        box-shadow: 0 1rem 2.75rem rgba(0, 0, 0, 0.22);
    }

    .bfa-aluno-hero__main {
        min-width: 0;
    }

    .bfa-aluno-hero__eyebrow,
    .bfa-aluno-shortcuts-card__eyebrow {
        margin: 0 0 0.35rem;
        color: var(--bfa-accent);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .bfa-aluno-hero__title {
        margin: 0;
        color: var(--bfa-white);
        font-size: clamp(1.45rem, 3vw, 2rem);
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .bfa-aluno-hero__description {
        max-width: 40rem;
        margin: 0.65rem 0 0;
        color: var(--bfa-text-secondary);
    }

    .bfa-aluno-hero__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    .bfa-aluno-hero__summary {
        display: grid;
        gap: 0.35rem;
        align-content: start;
        padding: 1rem 1.1rem;
        border-radius: var(--radius-lg);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0.005));
    }

    .bfa-aluno-hero__summary-label {
        margin: 0;
        color: var(--bfa-text-secondary);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .bfa-aluno-hero__summary strong {
        color: var(--bfa-white);
        font-size: clamp(1.1rem, 2.6vw, 1.45rem);
    }

    .bfa-aluno-hero__summary span {
        color: var(--bfa-text-muted);
        font-size: 0.85rem;
    }

    .bfa-aluno-stats {
        margin-top: 0.05rem;
    }

    .bfa-aluno-shortcuts-card {
        margin-top: 0.05rem;
    }

    .bfa-aluno-shortcuts-card__header {
        margin-bottom: 1rem;
    }

    .bfa-aluno-shortcuts-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    @@media (max-width: 64rem) {
        .bfa-aluno-hero {
            grid-template-columns: 1fr;
        }

        .bfa-aluno-shortcuts-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 42.5rem) {
        .bfa-aluno-shortcuts-grid {
            grid-template-columns: 1fr;
        }

        .bfa-aluno-hero {
            padding: 1rem;
        }
    }
</style>
}
