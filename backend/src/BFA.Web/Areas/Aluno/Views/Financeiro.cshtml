@model FinanceiroAlunoViewModel
@{
    ViewData["Title"] = "Financeiro";
    Layout = "_AlunoLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-financeiro-aluno">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Financeiro</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-financeiro-aluno">Situação Financeira</h1>
    </div>
</header>

<section class="bfa-admin-card bfa-aluno-financeiro-filter" aria-labelledby="titulo-filtro-financeiro">
    <div class="bfa-aluno-financeiro-card__header">
        <div>
            <p class="bfa-aluno-financeiro-card__eyebrow">Consulta</p>
            <h2 class="bfa-admin-card__title" id="titulo-filtro-financeiro">Período financeiro</h2>
        </div>
    </div>
    <form method="get" class="bfa-aluno-financeiro-filter__form">
        <div class="bfa-form-field">
            <label class="bfa-form-label" for="periodo">Período</label>
            <select class="form-select bfa-form-control" id="periodo" name="periodo">
                <option value="todos" selected="@(Model.Periodo == "todos" ? "selected" : null)">Todo o histórico</option>
                <option value="hoje" selected="@(Model.Periodo == "hoje" ? "selected" : null)">Hoje</option>
                <option value="mes" selected="@(Model.Periodo == "mes" ? "selected" : null)">Este mês</option>
                <option value="personalizado" selected="@(Model.Periodo == "personalizado" ? "selected" : null)">Personalizado</option>
            </select>
        </div>
        <div class="bfa-form-field">
            <label class="bfa-form-label" for="dataInicio">Data inicial</label>
            <div class="bfa-admin-date-field" data-bfa-date-field>
                <input class="form-control bfa-form-control" id="dataInicio" name="dataInicio" type="text"
                       inputmode="numeric" placeholder="dd/mm/aaaa" maxlength="10"
                       value="@Model.DataInicio" data-bfa-date-input />
                <button class="bfa-admin-date-field__trigger" type="button" aria-label="Abrir calendário da data inicial" data-bfa-date-trigger>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"></path></svg>
                </button>
            </div>
        </div>
        <div class="bfa-form-field">
            <label class="bfa-form-label" for="dataFim">Data final</label>
            <div class="bfa-admin-date-field" data-bfa-date-field>
                <input class="form-control bfa-form-control" id="dataFim" name="dataFim" type="text"
                       inputmode="numeric" placeholder="dd/mm/aaaa" maxlength="10"
                       value="@Model.DataFim" data-bfa-date-input />
                <button class="bfa-admin-date-field__trigger" type="button" aria-label="Abrir calendário da data final" data-bfa-date-trigger>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"></path></svg>
                </button>
            </div>
        </div>
        <button class="bfa-btn-primary bfa-admin-button" type="submit">Filtrar</button>
        <a class="bfa-btn-secondary bfa-admin-button" asp-route-periodo="todos">Limpar</a>
    </form>
</section>

<section class="bfa-aluno-financeiro-hero">
    <div class="bfa-aluno-financeiro-hero__main">
        <p class="bfa-aluno-financeiro-hero__eyebrow">Resumo financeiro</p>
        <h2 class="bfa-aluno-financeiro-hero__title">Acompanhe cobranças e pagamentos</h2>
        <p class="bfa-aluno-financeiro-hero__description">Tudo que está aberto, quitado e registrado aparece nesta tela.</p>
    </div>

    <div class="bfa-aluno-financeiro-hero__stats">
        <div class="bfa-admin-card bfa-aluno-financeiro-stat">
            <span class="bfa-aluno-financeiro-stat__label">Pendente</span>
            <strong class="bfa-aluno-financeiro-stat__value bfa-admin-metric-card__value--danger">@Model.TotalPendente</strong>
        </div>
        <div class="bfa-admin-card bfa-aluno-financeiro-stat">
            <span class="bfa-aluno-financeiro-stat__label">Pago</span>
            <strong class="bfa-aluno-financeiro-stat__value">@Model.TotalPago</strong>
        </div>
        <div class="bfa-admin-card bfa-aluno-financeiro-stat">
            <span class="bfa-aluno-financeiro-stat__label">Cobranças</span>
            <strong class="bfa-aluno-financeiro-stat__value">@Model.Cobrancas.Count</strong>
        </div>
    </div>
</section>

@if (Model.Cobrancas.Count > 0)
{
    <div class="bfa-admin-card bfa-aluno-financeiro-card">
        <div class="bfa-aluno-financeiro-card__header">
            <div>
                <p class="bfa-aluno-financeiro-card__eyebrow">Cobranças</p>
                <h2 class="bfa-admin-card__title">Histórico de cobranças</h2>
            </div>
        </div>
        <div class="bfa-admin-table-container bfa-admin-desktop-list">
            <table class="bfa-admin-table">
                <thead>
                    <tr>
                        <th>Descrição</th>
                        <th>Tipo</th>
                        <th>Valor</th>
                        <th>Vencimento</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Cobrancas)
                    {
                        <tr>
                            <td>@c.Descricao</td>
                            <td>@c.Tipo</td>
                            <td>@c.Valor</td>
                            <td>@c.DataVencimento</td>
                            <td>
                                <span class="bfa-admin-badge @(c.IsAtrasada ? "is-overdue" : null)">
                                    @c.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="bfa-admin-mobile-list">
            @foreach (var c in Model.Cobrancas)
            {
                <div class="bfa-admin-mobile-list__item">
                    <div class="bfa-admin-mobile-list__header">
                        <span class="bfa-admin-mobile-list__name">@c.Descricao</span>
                        <span class="bfa-admin-badge @(c.IsAtrasada ? "is-overdue" : null)">
                            @c.Status
                        </span>
                    </div>
                    <div class="bfa-admin-mobile-list__details">
                        <span>@c.Tipo</span>
                        <span>@c.Valor</span>
                    </div>
                    <div class="bfa-admin-mobile-list__details">
                        <span>Venc: @c.DataVencimento</span>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (Model.Pagamentos.Count > 0)
{
    <div class="bfa-admin-card bfa-aluno-financeiro-card">
        <div class="bfa-aluno-financeiro-card__header">
            <div>
                <p class="bfa-aluno-financeiro-card__eyebrow">Pagamentos</p>
                <h2 class="bfa-admin-card__title">Histórico de pagamentos</h2>
            </div>
        </div>
        <div class="bfa-admin-table-container bfa-admin-desktop-list">
            <table class="bfa-admin-table">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Valor</th>
                        <th>Forma</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Pagamentos)
                    {
                        <tr>
                            <td>@p.DataPagamento</td>
                            <td>@p.Tipo</td>
                            <td>@p.Valor</td>
                            <td>@p.FormaPagamento</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="bfa-admin-mobile-list">
            @foreach (var p in Model.Pagamentos)
            {
                <div class="bfa-admin-mobile-list__item">
                    <div class="bfa-admin-mobile-list__header">
                        <span class="bfa-admin-mobile-list__name">@p.Tipo</span>
                        <strong>@p.Valor</strong>
                    </div>
                    <div class="bfa-admin-mobile-list__details">
                        <span>@p.DataPagamento</span>
                        <span>@p.FormaPagamento</span>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Styles {
<style>
    .bfa-aluno-financeiro-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.95fr);
        gap: 1rem;
        padding: 1.25rem;
        border: 1px solid var(--bfa-border);
        border-radius: var(--radius-lg);
        background:
            radial-gradient(circle at top left, rgba(255, 193, 7, 0.1), transparent 18rem),
            linear-gradient(145deg, rgba(29, 32, 35, 0.98), rgba(21, 23, 25, 0.98));
        box-shadow: 0 1rem 2.75rem rgba(0, 0, 0, 0.22);
    }

    .bfa-aluno-financeiro-hero__eyebrow,
    .bfa-aluno-financeiro-card__eyebrow {
        margin: 0 0 0.35rem;
        color: var(--bfa-accent);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .bfa-aluno-financeiro-hero__title {
        margin: 0;
        color: var(--bfa-white);
        font-size: clamp(1.4rem, 3vw, 2rem);
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .bfa-aluno-financeiro-hero__description {
        max-width: 40rem;
        margin: 0.6rem 0 0;
        color: var(--bfa-text-secondary);
    }

    .bfa-aluno-financeiro-hero__stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem;
    }

    .bfa-aluno-financeiro-stat {
        display: grid;
        gap: 0.35rem;
        align-content: start;
        min-width: 0;
    }

    .bfa-aluno-financeiro-stat__label {
        color: var(--bfa-text-secondary);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .bfa-aluno-financeiro-stat__value {
        color: var(--bfa-white);
        font-size: clamp(1.3rem, 3vw, 1.8rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        white-space: nowrap;
    }

    .bfa-aluno-financeiro-filter,
    .bfa-aluno-financeiro-card {
        display: grid;
        gap: 1rem;
    }

    .bfa-aluno-financeiro-filter__form {
        display: grid;
        grid-template-columns: minmax(10rem, 0.8fr) repeat(2, minmax(11rem, 1fr)) auto auto;
        align-items: end;
        gap: 0.85rem;
    }

    .bfa-aluno-financeiro-filter__form .bfa-admin-button {
        white-space: nowrap;
    }

    .bfa-aluno-financeiro-card {
        display: grid;
        gap: 1rem;
    }

    .bfa-aluno-financeiro-card__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    @@media (max-width: 64rem) {
        .bfa-aluno-financeiro-hero {
            grid-template-columns: 1fr;
        }

        .bfa-aluno-financeiro-hero__stats {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .bfa-aluno-financeiro-filter__form {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .bfa-aluno-financeiro-filter__form .bfa-admin-button {
            width: 100%;
        }
    }

    @@media (max-width: 42.5rem) {
        .bfa-aluno-financeiro-hero__stats {
            grid-template-columns: 1fr;
        }

        .bfa-aluno-financeiro-card__header {
            flex-direction: column;
        }

        .bfa-aluno-financeiro-filter__form {
            grid-template-columns: 1fr;
        }
    }
</style>
}

@section Scripts {
    <script src="~/js/bfa-date-field.js" asp-append-version="true"></script>
}
