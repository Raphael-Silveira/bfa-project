@{
    var alunoNome = ViewData["AlunoNome"] as string
        ?? User.Identity?.Name
        ?? "Aluno";
    var unidadeId = Context.Request.RouteValues["unidadeId"]?.ToString() ?? string.Empty;

    Layout = "/Views/Shared/_AdminLayout.cshtml";
    ViewData[AdminShellViewData.Chave] = new AdminShellViewModel
    {
        AreaNome = "Aluno",
        ContextoNome = alunoNome,
        HomeUrl = $"/aluno/{unidadeId}",
        HomeAriaLabel = $"Ir para o painel do aluno {alunoNome}",
        NavegacaoAriaLabel = $"Navegação do aluno {alunoNome}",
        NavegacaoTitulo = "Minha Área",
        MenuDescricao = "menu do aluno",
        NavegacaoPartial = "/Areas/Aluno/Views/Shared/_AlunoNavLinks.cshtml"
    };
}

@RenderBody()

@section AreaStyles {
    <link rel="stylesheet" href="~/css/unidade.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
