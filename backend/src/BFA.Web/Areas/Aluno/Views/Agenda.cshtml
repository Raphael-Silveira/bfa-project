@model IReadOnlyList<AulaAlunoViewModel>
@{
    ViewData["Title"] = "Agenda";
    Layout = "_AlunoLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-agenda-aluno">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Agenda</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-agenda-aluno">Próximas Aulas</h1>
        <p class="bfa-admin-page-header__description">Últimos 7 dias + próximos 30 dias.</p>
    </div>
</header>

@if (Model.Count == 0)
{
    <section class="bfa-admin-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            <h2>Nenhuma aula encontrada no período.</h2>
            <p>Quando houver aulas agendadas, elas aparecerão nesta lista.</p>
        </div>
    </section>
}
else
{
    <div class="bfa-admin-card bfa-aluno-agenda-card">
        <div class="bfa-aluno-agenda-card__header">
            <div>
                <p class="bfa-aluno-agenda-card__eyebrow">Agenda</p>
                <h2 class="bfa-admin-card__title">Lista de aulas</h2>
            </div>
            <span class="bfa-admin-badge is-active">@Model.Count aulas</span>
        </div>
        <div class="bfa-admin-table-container bfa-admin-desktop-list">
            <table class="bfa-admin-table">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Turma</th>
                        <th>Horário</th>
                        <th>Status</th>
                        <th>Participação</th>
                        <th class="bfa-aluno-acoes-heading">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var aula in Model)
                    {
                        <tr>
                            <td>@aula.Data</td>
                            <td>@aula.TurmaNome</td>
                            <td>@aula.HoraInicio – @aula.HoraFim</td>
                            <td>
                                <span class="bfa-admin-badge @(aula.IsProgramada ? "is-active" : null)">
                                    @aula.Status
                                </span>
                            </td>
                            <td class="bfa-aluno-participacao">
                                <span class="bfa-admin-badge @(aula.ConfirmacaoAtiva ? "is-active" : null)">
                                    @(aula.ConfirmacaoAtiva ? "Confirmado" : "Não confirmado")
                                </span>
                            </td>
                            <td class="bfa-aluno-acoes">
                                @if (aula.PodeAlterarConfirmacao)
                                {
                                    <form method="post" class="bfa-aluno-confirmacao-form"
                                          asp-area="Aluno" asp-controller="Aluno"
                                          asp-action="@(aula.ConfirmacaoAtiva ? "CancelarConfirmacao" : "ConfirmarParticipacao")"
                                          asp-route-unidadeId="@Context.Request.RouteValues["unidadeId"]"
                                          asp-route-aulaId="@aula.AulaId">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="bfa-btn-secondary bfa-aluno-confirmacao-button">
                                            @(aula.ConfirmacaoAtiva ? "Cancelar" : "Confirmar")
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="bfa-admin-mobile-list">
            @foreach (var aula in Model)
            {
                <div class="bfa-admin-mobile-list__item">
                    <div class="bfa-admin-mobile-list__header">
                        <span class="bfa-admin-mobile-list__name">@aula.TurmaNome</span>
                        <span class="bfa-admin-badge @(aula.IsProgramada ? "is-active" : null)">
                            @aula.Status
                        </span>
                    </div>
                    <div class="bfa-admin-mobile-list__details">
                        <span>@aula.Data</span>
                        <span>@aula.HoraInicio – @aula.HoraFim</span>
                        <div class="bfa-aluno-mobile-participacao">
                            <span class="bfa-aluno-mobile-participacao__label">Participação</span>
                            <span class="bfa-admin-badge @(aula.ConfirmacaoAtiva ? "is-active" : null)">
                                @(aula.ConfirmacaoAtiva ? "Confirmado" : "Não confirmado")
                            </span>
                        </div>
                    </div>
                    @if (aula.PodeAlterarConfirmacao)
                    {
                        <form method="post" class="bfa-aluno-confirmacao-form"
                              asp-area="Aluno" asp-controller="Aluno"
                              asp-action="@(aula.ConfirmacaoAtiva ? "CancelarConfirmacao" : "ConfirmarParticipacao")"
                              asp-route-unidadeId="@Context.Request.RouteValues["unidadeId"]"
                              asp-route-aulaId="@aula.AulaId">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="bfa-btn-secondary bfa-aluno-confirmacao-button">
                                @(aula.ConfirmacaoAtiva ? "Cancelar" : "Confirmar")
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
}

@section Styles {
<style>
    .bfa-aluno-agenda-card {
        display: grid;
        gap: 1rem;
    }

    .bfa-aluno-agenda-card__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .bfa-aluno-agenda-card__eyebrow {
        margin: 0 0 0.35rem;
        color: var(--bfa-accent);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .bfa-aluno-confirmacao-form {
        display: inline-flex;
        margin: 0;
    }

    .bfa-aluno-participacao {
        width: 10rem;
        vertical-align: middle;
    }

    .bfa-aluno-acoes-heading,
    .bfa-aluno-acoes {
        text-align: left;
        vertical-align: middle;
        width: 8rem;
    }

    .bfa-aluno-acoes > .bfa-aluno-confirmacao-form {
        align-items: center;
        justify-content: flex-start;
    }

    .bfa-aluno-confirmacao-button {
        min-height: 2.25rem;
        padding: 0.4rem 0.7rem;
        white-space: nowrap;
    }

    .bfa-aluno-mobile-participacao {
        align-items: center;
        display: inline-flex;
        gap: 0.55rem;
        flex-wrap: wrap;
    }

    .bfa-aluno-mobile-participacao__label {
        color: var(--bfa-text-secondary);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    @@media (max-width: 42.5rem) {
        .bfa-aluno-agenda-card__header {
            flex-direction: column;
        }

        .bfa-aluno-confirmacao-form {
            margin-top: 0.7rem;
        }

        .bfa-aluno-confirmacao-button {
            width: auto;
        }
    }
</style>
}
