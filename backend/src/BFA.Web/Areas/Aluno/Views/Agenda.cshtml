@model IReadOnlyList<AulaAlunoViewModel>
@{
    ViewData["Title"] = "Agenda";
    Layout = "_AlunoLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-agenda-aluno">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Agenda</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-agenda-aluno">Próximas Aulas</h1>
        <p class="bfa-admin-page-header__description">Últimos 7 dias + próximos 30 dias.</p>
    </div>
</header>

@if (Model.Count == 0)
{
    <div class="bfa-admin-card">
        <p class="bfa-admin-empty-state">Nenhuma aula encontrada no período.</p>
    </div>
}
else
{
    <div class="bfa-admin-card">
        <div class="bfa-admin-table-container bfa-admin-desktop-list">
            <table class="bfa-admin-table">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Turma</th>
                        <th>Horário</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var aula in Model)
                    {
                        <tr>
                            <td>@aula.Data</td>
                            <td>@aula.TurmaNome</td>
                            <td>@aula.HoraInicio – @aula.HoraFim</td>
                            <td>
                                <span class="bfa-admin-badge @(aula.IsProgramada ? "is-active" : null)">
                                    @aula.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="bfa-admin-mobile-list">
            @foreach (var aula in Model)
            {
                <div class="bfa-admin-mobile-list__item">
                    <div class="bfa-admin-mobile-list__header">
                        <span class="bfa-admin-mobile-list__name">@aula.TurmaNome</span>
                        <span class="bfa-admin-badge @(aula.IsProgramada ? "is-active" : null)">
                            @aula.Status
                        </span>
                    </div>
                    <div class="bfa-admin-mobile-list__details">
                        <span>@aula.Data</span>
                        <span>@aula.HoraInicio – @aula.HoraFim</span>
                    </div>
                </div>
            }
        </div>
    </div>
}
