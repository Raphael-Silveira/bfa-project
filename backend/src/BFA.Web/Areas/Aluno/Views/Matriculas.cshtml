@model IReadOnlyList<MatriculaAlunoViewModel>
@{
    ViewData["Title"] = "Matrículas";
    Layout = "_AlunoLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-matriculas-aluno">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Matrículas</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-matriculas-aluno">Minhas Matrículas</h1>
    </div>
</header>

@if (Model.Count == 0)
{
    <section class="bfa-admin-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            <h2>Nenhuma matrícula encontrada.</h2>
            <p>Quando houver vínculos ativos ou encerrados, eles aparecerão aqui.</p>
        </div>
    </section>
}
else
{
    <div class="bfa-admin-card bfa-aluno-matriculas-card">
        <div class="bfa-aluno-matriculas-card__header">
            <div>
                <p class="bfa-aluno-matriculas-card__eyebrow">Matrículas</p>
                <h2 class="bfa-admin-card__title">Meu histórico acadêmico</h2>
            </div>
            <span class="bfa-admin-badge is-active">@Model.Count vínculos</span>
        </div>
        <div class="bfa-admin-table-container bfa-admin-desktop-list">
            <table class="bfa-admin-table">
                <thead>
                    <tr>
                        <th>Plano</th>
                        <th>Status</th>
                        <th>Início</th>
                        <th>Término previsto</th>
                        <th>Valor mensal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var matricula in Model)
                    {
                        <tr>
                            <td>@matricula.PlanoNome</td>
                            <td>
                                <span class="bfa-admin-badge @(matricula.Status == "Ativa" ? "is-active" : null)">
                                    @matricula.Status
                                </span>
                            </td>
                            <td>@matricula.DataInicio</td>
                            <td>@matricula.DataFimPrevista</td>
                            <td>@matricula.ValorMensal</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="bfa-admin-mobile-list">
            @foreach (var matricula in Model)
            {
                <div class="bfa-admin-mobile-list__item">
                    <div class="bfa-admin-mobile-list__header">
                        <span class="bfa-admin-mobile-list__name">@matricula.PlanoNome</span>
                        <span class="bfa-admin-badge @(matricula.Status == "Ativa" ? "is-active" : null)">
                            @matricula.Status
                        </span>
                    </div>
                    <div class="bfa-admin-mobile-list__details">
                        <span>Início: @matricula.DataInicio</span>
                        <span>@matricula.ValorMensal/mês</span>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Styles {
<style>
    .bfa-aluno-matriculas-card {
        display: grid;
        gap: 1rem;
    }

    .bfa-aluno-matriculas-card__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .bfa-aluno-matriculas-card__eyebrow {
        margin: 0 0 0.35rem;
        color: var(--bfa-accent);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    @@media (max-width: 42.5rem) {
        .bfa-aluno-matriculas-card__header {
            flex-direction: column;
        }
    }
</style>
}
