@using BFA.Web.ViewModels.Shared
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    ViewData[AdminShellViewData.Chave] = new AdminShellViewModel
    {
        AreaNome = "Franqueadora",
        HomeUrl = "/franqueadora",
        HomeAriaLabel = "Ir para a visão geral da Franqueadora",
        NavegacaoAriaLabel = "Navegação da Franqueadora",
        NavegacaoTitulo = "Administração",
        MenuDescricao = "menu administrativo",
        NavegacaoPartial = "/Areas/Franqueadora/Views/Shared/_FranqueadoraNavLinks.cshtml"
    };
}

@RenderBody()

@section AreaStyles {
    <link rel="stylesheet" href="~/css/franqueadora.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
