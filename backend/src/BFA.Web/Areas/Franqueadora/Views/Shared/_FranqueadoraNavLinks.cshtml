@{
    var caminhoAtual = Context.Request.Path.Value?.TrimEnd('/') ?? string.Empty;
    var visaoGeralAtiva = string.Equals(
        caminhoAtual,
        "/franqueadora",
        StringComparison.OrdinalIgnoreCase);
    var unidadesAtiva = caminhoAtual.StartsWith(
        "/franqueadora/unidades",
        StringComparison.OrdinalIgnoreCase);
    var alunosAtiva = caminhoAtual.StartsWith(
        "/franqueadora/alunos",
        StringComparison.OrdinalIgnoreCase);
    var usuariosAtiva = caminhoAtual.StartsWith(
        "/franqueadora/usuarios",
        StringComparison.OrdinalIgnoreCase);
    var franqueadosAtiva = caminhoAtual.StartsWith(
        "/franqueadora/franqueados",
        StringComparison.OrdinalIgnoreCase);
    var planosAtiva = caminhoAtual.StartsWith(
        "/franqueadora/planos",
        StringComparison.OrdinalIgnoreCase);
}

<a class="bfa-admin-nav-link @(visaoGeralAtiva ? "is-active" : null)"
   href="/franqueadora"
   aria-current="@(visaoGeralAtiva ? "page" : null)">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 4h6v6H4z"></path>
        <path d="M14 4h6v6h-6z"></path>
        <path d="M4 14h6v6H4z"></path>
        <path d="M14 14h6v6h-6z"></path>
    </svg>
    <span>Visão Geral</span>
</a>
<a class="bfa-admin-nav-link @(usuariosAtiva ? "is-active" : null)"
   href="/franqueadora/usuarios"
   aria-current="@(usuariosAtiva ? "page" : null)">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M19 8v6"></path>
        <path d="M16 11h6"></path>
    </svg>
    <span>Usuários</span>
</a>
<a class="bfa-admin-nav-link @(unidadesAtiva ? "is-active" : null)"
   href="/franqueadora/unidades"
   aria-current="@(unidadesAtiva ? "page" : null)">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 20V8l8-4 8 4v12"></path>
        <path d="M9 20v-6h6v6"></path>
        <path d="M2 20h20"></path>
    </svg>
    <span>Unidades</span>
</a>
<a class="bfa-admin-nav-link @(alunosAtiva ? "is-active" : null)"
   href="/franqueadora/alunos"
   aria-current="@(alunosAtiva ? "page" : null)">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
    </svg>
    <span>Alunos da Rede</span>
</a>
<a class="bfa-admin-nav-link @(franqueadosAtiva ? "is-active" : null)"
   href="/franqueadora/franqueados"
   aria-current="@(franqueadosAtiva ? "page" : null)">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 20V9l8-5 8 5v11"></path>
        <path d="M8 20v-6h8v6"></path>
        <path d="M9 10h6"></path>
    </svg>
    <span>Franqueados</span>
</a>
<a class="bfa-admin-nav-link @(planosAtiva ? "is-active" : null)"
   href="/franqueadora/planos"
   aria-current="@(planosAtiva ? "page" : null)">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 5h16v14H4z"></path>
        <path d="M8 9h8M8 13h5M8 17h3"></path>
    </svg>
    <span>Planos da Rede</span>
</a>
