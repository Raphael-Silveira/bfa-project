@model FranqueadoItemViewModel

<div class="bfa-admin-actions">
    <a class="bfa-admin-icon-action"
       href="/franqueadora/franqueados/@Model.Id"
       aria-label="Visualizar franqueado @Model.NomeRazaoSocial"
       title="Visualizar franqueado @Model.NomeRazaoSocial">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path>
            <circle cx="12" cy="12" r="2.5"></circle>
        </svg>
    </a>
    <a class="bfa-admin-icon-action is-edit"
       href="/franqueadora/franqueados/@Model.Id/editar"
       aria-label="Editar franqueado @Model.NomeRazaoSocial"
       title="Editar franqueado @Model.NomeRazaoSocial">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 20h4l11-11a2.8 2.8 0 0 0-4-4L4 16v4Z"></path>
            <path d="m13.5 6.5 4 4"></path>
        </svg>
    </a>
</div>
