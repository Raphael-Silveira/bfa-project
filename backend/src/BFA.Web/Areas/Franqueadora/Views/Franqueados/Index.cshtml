@model FranqueadosIndexViewModel
@{
    ViewData["Title"] = "Franqueados";
    Layout = "_FranqueadoraLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-franqueados">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Rede BFA</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-franqueados">Franqueados</h1>
        <p class="bfa-admin-page-header__description">Consulte os dados comerciais, usuários e Unidades relacionados aos Franqueados.</p>
    </div>
</header>

@if (Model.Franqueados.Count == 0)
{
    <section class="bfa-admin-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            <h2>Nenhum franqueado cadastrado.</h2>
            <p>Os Franqueados são criados pelo fluxo de cadastro de usuários.</p>
        </div>
    </section>
}
else
{
    <div class="bfa-data-card bfa-admin-desktop-list">
        <div class="bfa-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Nome / Razão social</th>
                        <th>Nome fantasia</th>
                        <th>CPF / CNPJ</th>
                        <th>Tipo</th>
                        <th>Unidades ativas</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var franqueado in Model.Franqueados)
                {
                    <tr>
                        <td>
                            <div class="bfa-data-primary">@franqueado.NomeRazaoSocial</div>
                        </td>
                        <td>@(franqueado.NomeFantasia ?? "—")</td>
                        <td>@franqueado.DocumentoFormatado</td>
                        <td>@franqueado.TipoPessoa</td>
                        <td>@franqueado.QuantidadeUnidadesAtivas</td>
                        <td>
                            <span class="bfa-data-badge @(franqueado.Ativo ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                                <i class="bfa-data-badge__dot"></i>
                                @(franqueado.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <div class="bfa-actions-cell">
                                <partial name="_FranqueadoAcoes" model="franqueado" />
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <section class="bfa-mobile-card-list" aria-label="Franqueados cadastrados">
        @foreach (var franqueado in Model.Franqueados)
        {
            <article class="bfa-mobile-card">
                <div class="bfa-mobile-card__head">
                    <div>
                        <div class="bfa-data-primary">@franqueado.NomeRazaoSocial</div>
                        @if (!string.IsNullOrWhiteSpace(franqueado.NomeFantasia))
                        {
                            <div class="bfa-data-secondary">@franqueado.NomeFantasia</div>
                        }
                    </div>
                    <span class="bfa-data-badge @(franqueado.Ativo ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                        <i class="bfa-data-badge__dot"></i>
                        @(franqueado.Ativo ? "Ativo" : "Inativo")
                    </span>
                </div>
                <div class="bfa-mobile-card__grid">
                    <div>
                        <span class="bfa-mobile-card__label">CPF / CNPJ</span>
                        <div>@franqueado.DocumentoFormatado</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Tipo</span>
                        <div>@franqueado.TipoPessoa</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Unidades ativas</span>
                        <div>@franqueado.QuantidadeUnidadesAtivas</div>
                    </div>
                </div>
                <div class="bfa-mobile-card__actions">
                    <partial name="_FranqueadoAcoes" model="franqueado" />
                </div>
            </article>
        }
    </section>
}
