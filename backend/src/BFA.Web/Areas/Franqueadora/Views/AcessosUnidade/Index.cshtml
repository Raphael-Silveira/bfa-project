@model AcessosUnidadeViewModel
@{
    ViewData["Title"] = "Acessos administrativos";
    Layout = "_FranqueadoraLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-acessos">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Unidade</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-acessos">Acessos administrativos</h1>
        <p class="bfa-admin-page-header__description">
            Gerencie os administradores da unidade <strong>@Model.UnidadeNome</strong>.
            Status: <span class="bfa-data-badge @(Model.UnidadeAtiva ? "bfa-data-badge--active" : "bfa-data-badge--inactive")"><i class="bfa-data-badge__dot"></i> @(Model.UnidadeAtiva ? "Ativa" : "Inativa")</span>
        </p>
    </div>
    <div class="bfa-admin-page-header__actions">
        <a class="bfa-btn-primary bfa-admin-button" href="#adicionar-administrador">Adicionar administrador</a>
    </div>
</header>

<section class="bfa-data-card bfa-form-card" id="adicionar-administrador" aria-labelledby="titulo-adicionar-administrador">
    <div class="bfa-card-title-row">
        <h2 class="bfa-card-title-row__title" id="titulo-adicionar-administrador">Adicionar administrador</h2>
    </div>
    <p class="bfa-data-secondary">
        O usuário precisa possuir cadastro na BFA. Convites para novos usuários serão implementados futuramente.
    </p>

    <form class="bfa-admin-form"
          action="/franqueadora/unidades/@Model.UnidadeId/acessos/adicionar"
          method="post"
          novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="bfa-validation-message" role="alert"></div>

        <div class="bfa-fields">
            <div class="bfa-field">
                <label asp-for="Email" class="bfa-form-label"></label>
                <input asp-for="Email"
                       class="bfa-form-control"
                       type="email"
                       maxlength="256"
                       autocomplete="email" />
                <span asp-validation-for="Email" class="bfa-validation-message"></span>
            </div>
        </div>

        <div class="bfa-admin-form-actions">
            <button class="bfa-btn-primary bfa-admin-button" type="submit">Adicionar</button>
            <a class="bfa-btn-secondary bfa-admin-button" href="/franqueadora/unidades">Voltar</a>
        </div>
    </form>
</section>

@if (Model.Administradores.Count == 0)
{
    <section class="bfa-admin-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            <h2>Nenhum administrador vinculado.</h2>
            <p>Adicione um usuário cadastrado para administrar esta unidade.</p>
        </div>
    </section>
}
else
{
    <div class="bfa-data-card bfa-admin-desktop-list">
        <div class="bfa-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Desde</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var administrador in Model.Administradores)
                {
                    <tr>
                        <td>@administrador.Email</td>
                        <td>
                            <span class="bfa-data-badge @(administrador.Ativo ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                                <i class="bfa-data-badge__dot"></i>
                                @(administrador.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>@administrador.CriadoEmUtc.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="bfa-actions-cell">
                                <partial name="_AdministradorUnidadeAcoes" model="administrador" />
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <section class="bfa-mobile-card-list" aria-label="Administradores da unidade">
        @foreach (var administrador in Model.Administradores)
        {
            <article class="bfa-mobile-card">
                <div class="bfa-mobile-card__head">
                    <div>
                        <div class="bfa-data-primary">@administrador.Email</div>
                    </div>
                    <span class="bfa-data-badge @(administrador.Ativo ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                        <i class="bfa-data-badge__dot"></i>
                        @(administrador.Ativo ? "Ativo" : "Inativo")
                    </span>
                </div>
                <div class="bfa-mobile-card__grid">
                    <div>
                        <span class="bfa-mobile-card__label">Desde</span>
                        <div>@administrador.CriadoEmUtc.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
                <div class="bfa-mobile-card__actions">
                    <partial name="_AdministradorUnidadeAcoes" model="administrador" />
                </div>
            </article>
        }
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
