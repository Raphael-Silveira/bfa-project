@model UsuariosFranqueadoraIndexViewModel
@{
    ViewData["Title"] = "Usuários";
    Layout = "_FranqueadoraLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-usuarios">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Acessos da rede</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-usuarios">Usuários</h1>
        <p class="bfa-admin-page-header__description">Consulte as pessoas relacionadas à Organização e cadastre novos acessos.</p>
    </div>
    <div class="bfa-admin-page-header__actions">
        <a class="bfa-btn-primary bfa-admin-button" href="/franqueadora/usuarios/novo">Novo usuário</a>
    </div>
</header>

@if (TempData[nameof(BFA.Web.Areas.Franqueadora.Controllers.UsuariosController.MensagemUsuarioAtualizado)] is string mensagem)
{
    <div class="bfa-admin-notice" role="status"><strong>@mensagem</strong></div>
}

@if (Model.Usuarios.Count == 0)
{
    <section class="bfa-admin-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            <h2>Nenhum usuário relacionado.</h2>
            <p>Use o botão "Novo usuário" para iniciar o cadastro.</p>
        </div>
    </section>
}
else
{
    <div class="bfa-data-card bfa-admin-desktop-list">
        <div class="bfa-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Email</th>
                        <th>Função</th>
                        <th>Acesso às unidades</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var usuario in Model.Usuarios)
                {
                    <tr>
                        <td>
                            <div class="bfa-data-primary">@usuario.Nome</div>
                        </td>
                        <td>@usuario.Email</td>
                        <td>
                            <div class="bfa-usuario-tags">
                                @foreach (var funcao in usuario.Funcoes)
                                {
                                    <span class="bfa-usuario-tag">@funcao</span>
                                }
                            </div>
                        </td>
                        <td>
                            @if (usuario.AcessoTodaRede)
                            {
                                <span class="bfa-data-secondary">Toda a rede</span>
                            }
                            else if (usuario.Unidades.Count == 0)
                            {
                                <span class="bfa-data-secondary">Sem acesso a unidades</span>
                            }
                            else
                            {
                                <span>@string.Join(", ", usuario.Unidades)</span>
                            }
                        </td>
                        <td>
                            <span class="bfa-data-badge @(usuario.Ativo ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                                <i class="bfa-data-badge__dot"></i>
                                @(usuario.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <div class="bfa-actions-cell">
                                <partial name="_UsuarioAcoes" model="usuario" />
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <section class="bfa-mobile-card-list" aria-label="Usuários relacionados">
        @foreach (var usuario in Model.Usuarios)
        {
            <article class="bfa-mobile-card">
                <div class="bfa-mobile-card__head">
                    <div>
                        <div class="bfa-data-primary">@usuario.Nome</div>
                        <div class="bfa-data-secondary">@usuario.Email</div>
                    </div>
                    <span class="bfa-data-badge @(usuario.Ativo ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                        <i class="bfa-data-badge__dot"></i>
                        @(usuario.Ativo ? "Ativo" : "Inativo")
                    </span>
                </div>
                <div class="bfa-mobile-card__grid">
                    <div>
                        <span class="bfa-mobile-card__label">Função</span>
                        <div class="bfa-usuario-tags">
                            @foreach (var funcao in usuario.Funcoes)
                            {
                                <span class="bfa-usuario-tag">@funcao</span>
                            }
                        </div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Acesso às unidades</span>
                        <div>@(usuario.AcessoTodaRede ? "Toda a rede" : usuario.Unidades.Count == 0 ? "Sem acesso" : string.Join(", ", usuario.Unidades))</div>
                    </div>
                </div>
                <div class="bfa-mobile-card__actions">
                    <partial name="_UsuarioAcoes" model="usuario" />
                </div>
            </article>
        }
    </section>
}
