@using BFA.Application.Franqueadora.Unidades
@model UnidadesFranqueadoraIndexViewModel
@{
    ViewData["Title"] = "Unidades";
    Layout = "_FranqueadoraLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-unidades">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Rede BFA</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-unidades">Unidades</h1>
        <p class="bfa-admin-page-header__description">Gerencie as unidades vinculadas à sua Organização.</p>
    </div>
    <div class="bfa-admin-page-header__actions">
        <a class="bfa-btn-primary bfa-admin-button" href="/franqueadora/unidades/nova">Nova unidade</a>
    </div>
</header>

<section class="bfa-admin-filters bfa-unidades-filters" aria-label="Filtros de unidades">
    <form method="get" class="bfa-admin-filters__form">
        <div class="bfa-admin-filters__group bfa-unidades-filters__search">
            <label class="bfa-admin-filters__label" for="busca">Buscar unidade</label>
            <input class="bfa-admin-filters__input"
                   type="search"
                   id="busca"
                   name="busca"
                   value="@Model.Busca"
                   placeholder="Nome da unidade"
                   aria-label="Buscar unidade" />
        </div>
        <div class="bfa-admin-filters__group">
            <label class="bfa-admin-filters__label" for="tipo">Tipo</label>
            <select class="bfa-admin-filters__select" id="tipo" name="tipo">
                <option value="todos" selected="@(Model.Tipo == TipoUnidadeFiltro.Todos ? "selected" : null)">Todos</option>
                <option value="franqueadas" selected="@(Model.Tipo == TipoUnidadeFiltro.Franqueadas ? "selected" : null)">Franqueadas</option>
                <option value="rede" selected="@(Model.Tipo == TipoUnidadeFiltro.Rede ? "selected" : null)">Rede</option>
            </select>
        </div>
        <div class="bfa-admin-filters__actions">
            <button type="submit" class="bfa-admin-btn bfa-admin-btn--primary">Filtrar</button>
            <a href="/franqueadora/unidades" class="bfa-admin-btn bfa-admin-btn--secondary">Limpar</a>
        </div>
    </form>
</section>

@if (Model.Unidades.Count == 0)
{
    <section class="bfa-admin-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            @if (Model.PossuiFiltros)
            {
                <h2>Nenhuma unidade encontrada com os filtros informados.</h2>
                <p>Tente ajustar os filtros de busca.</p>
            }
            else
            {
                <h2>Nenhuma unidade cadastrada.</h2>
                <p>Use o botão "Nova unidade" para iniciar o cadastro.</p>
            }
        </div>
    </section>
}
else
{
    <div class="bfa-data-card bfa-admin-desktop-list">
        <div class="bfa-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Slug</th>
                        <th>Status</th>
                        <th>Data de criação</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var unidade in Model.Unidades)
                {
                    <tr>
                        <td>
                            <div class="bfa-data-primary">@unidade.Nome</div>
                        </td>
                        <td><code>@unidade.Slug</code></td>
                        <td>
                            <span class="bfa-data-badge @(unidade.Ativa ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                                <i class="bfa-data-badge__dot"></i>
                                @(unidade.Ativa ? "Ativa" : "Inativa")
                            </span>
                            <span class="bfa-data-badge @(unidade.PossuiFranqueadoAtivo ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                                @(unidade.PossuiFranqueadoAtivo ? "Franqueada" : "Rede")
                            </span>
                        </td>
                        <td>@unidade.CriadoEmUtc.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="bfa-actions-cell">
                                <partial name="_UnidadeAcoes" model="unidade" />
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <section class="bfa-mobile-card-list" aria-label="Unidades cadastradas">
        @foreach (var unidade in Model.Unidades)
        {
            <article class="bfa-mobile-card">
                <div class="bfa-mobile-card__head">
                    <div>
                        <div class="bfa-data-primary">@unidade.Nome</div>
                        <div class="bfa-data-secondary"><code>@unidade.Slug</code></div>
                    </div>
                    <span class="bfa-data-badge @(unidade.Ativa ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                        <i class="bfa-data-badge__dot"></i>
                        @(unidade.Ativa ? "Ativa" : "Inativa")
                    </span>
                </div>
                <div class="bfa-mobile-card__grid">
                    <div>
                        <span class="bfa-mobile-card__label">Criação</span>
                        <div>@unidade.CriadoEmUtc.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Situação</span>
                        <div>@(unidade.PossuiFranqueadoAtivo ? "Franqueada" : "Rede")</div>
                    </div>
                </div>
                <div class="bfa-mobile-card__actions">
                    <partial name="_UnidadeAcoes" model="unidade" />
                </div>
            </article>
        }
    </section>
}
