@model UnidadeFranqueadoraItemViewModel

<div class="bfa-admin-actions">
    @if (Model.Ativa)
    {
        <a class="bfa-admin-icon-action"
           href="/unidade/@Model.Id"
           aria-label="Entrar na unidade @Model.Nome"
           title="Entrar na unidade @Model.Nome">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M3 11 12 4l9 7"></path>
                <path d="M5 10v10h14V10"></path>
                <path d="M9 20v-6h6v6"></path>
            </svg>
        </a>
    }

    <a class="bfa-admin-icon-action"
       href="/franqueadora/unidades/@Model.Id/acessos"
       aria-label="Gerenciar acessos da unidade @Model.Nome"
       title="Gerenciar acessos da unidade @Model.Nome">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
    </a>

    <a class="bfa-admin-icon-action is-edit"
       href="/franqueadora/unidades/@Model.Id/editar"
       aria-label="Editar unidade @Model.Nome"
       title="Editar unidade @Model.Nome">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 20h4l11-11a2.8 2.8 0 0 0-4-4L4 16v4Z"></path>
            <path d="m13.5 6.5 4 4"></path>
        </svg>
    </a>

    @if (Model.Ativa)
    {
        <form action="/franqueadora/unidades/@Model.Id/desativar" method="post">
            @Html.AntiForgeryToken()
            <button class="bfa-admin-icon-action is-deactivate"
                    type="submit"
                    aria-label="Desativar unidade @Model.Nome"
                    title="Desativar unidade @Model.Nome">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M9 5v14"></path>
                    <path d="M15 5v14"></path>
                </svg>
            </button>
        </form>
    }
    else
    {
        <form action="/franqueadora/unidades/@Model.Id/ativar" method="post">
            @Html.AntiForgeryToken()
            <button class="bfa-admin-icon-action is-activate"
                    type="submit"
                    aria-label="Ativar unidade @Model.Nome"
                    title="Ativar unidade @Model.Nome">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="m5 12 4 4L19 6"></path>
                </svg>
            </button>
        </form>
    }
</div>
