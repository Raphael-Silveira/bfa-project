@using BFA.Web.ViewModels.Professor
@using BFA.Web.ViewModels.Shared
@model IProfessorContextoViewModel
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    ViewData[AdminShellViewData.Chave] = new AdminShellViewModel
    {
        AreaNome = "Professor",
        ContextoNome = Model.NomeUnidade,
        HomeUrl = $"/professor/unidade/{Model.UnidadeId:D}",
        HomeAriaLabel = $"Ir para a área do Professor na unidade {Model.NomeUnidade}",
        NavegacaoAriaLabel = "Navegação da Área do Professor",
        NavegacaoTitulo = "Minha área",
        MenuDescricao = "menu da Área do Professor",
        NavegacaoPartial = "/Areas/Professor/Views/Shared/_ProfessorNavLinks.cshtml",
        TrocarContextoUrl = Model.PodeTrocarUnidade ? "/professor/selecionar-unidade" : null,
        TrocarContextoTexto = Model.PodeTrocarUnidade ? "Trocar unidade" : null
    };
}
@RenderBody()
@section AreaStyles {
    <link rel="stylesheet" href="~/css/unidade.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}
@section Scripts { @await RenderSectionAsync("Scripts", required: false) }
