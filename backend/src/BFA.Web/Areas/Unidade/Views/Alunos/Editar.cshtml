@model EditarAlunoViewModel
@{
    ViewData["Title"] = "Editar dados do aluno";
    Layout = "_UnidadeLayout";
}

<header class="bfa-admin-page-header">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Aluno · @Model.NomeUnidade</p>
        <h1 class="bfa-admin-page-header__title">Editar dados de @Model.NomeCompleto</h1>
        <p class="bfa-admin-page-header__description">Atualize os dados cadastrais do aluno.</p>
    </div>
    <div class="bfa-admin-page-header__actions">
        <a class="bfa-btn-secondary bfa-admin-button"
           asp-area="Unidade"
           asp-controller="Alunos"
           asp-action="Detalhes"
           asp-route-unidadeId="@Model.UnidadeId"
           asp-route-alunoId="@Model.AlunoId">Voltar</a>
    </div>
</header>

<form class="bfa-admin-form"
      method="post"
      action="/unidade/@Model.UnidadeId/alunos/@Model.AlunoId/editar">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="bfa-admin-notice bfa-admin-form-summary" role="alert"></div>

    <div class="bfa-admin-form-sections">
        <section class="bfa-form-card">
            <div class="bfa-card-title-row">
                <div class="bfa-card-icon">&#128100;</div>
                <h2>Dados cadastrais</h2>
            </div>
            <div class="bfa-fields">
                <div class="bfa-field">
                    <label asp-for="NomeCompleto" class="bfa-form-label"></label>
                    <input asp-for="NomeCompleto" class="form-control bfa-form-control" autocomplete="name" />
                    <span asp-validation-for="NomeCompleto" class="bfa-validation-message"></span>
                </div>
                <div class="bfa-field-grid-2">
                    <div class="bfa-field">
                        <label asp-for="DataNascimento" class="bfa-form-label"></label>
                        <input asp-for="DataNascimento"
                               class="form-control bfa-form-control"
                               type="date"
                               max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="DataNascimento" class="bfa-validation-message"></span>
                    </div>
                    <div class="bfa-field">
                        <label asp-for="Cpf" class="bfa-form-label"></label>
                        <input asp-for="Cpf"
                               class="form-control bfa-form-control"
                               inputmode="numeric"
                               maxlength="14"
                               data-bfa-mask="document"
                               placeholder="000.000.000-00" />
                        <span asp-validation-for="Cpf" class="bfa-validation-message"></span>
                    </div>
                </div>
                <div class="bfa-field-grid-2">
                    <div class="bfa-field">
                        <label asp-for="Telefone" class="bfa-form-label"></label>
                        <input asp-for="Telefone"
                               class="form-control bfa-form-control"
                               inputmode="numeric"
                               data-bfa-mask="phone"
                               placeholder="(11) 91234-5678" />
                        <span asp-validation-for="Telefone" class="bfa-validation-message"></span>
                    </div>
                    <div class="bfa-field">
                        <label asp-for="Email" class="bfa-form-label"></label>
                        <input asp-for="Email"
                               class="form-control bfa-form-control"
                               type="email"
                               autocomplete="email"
                               placeholder="exemplo@bfa.com" />
                        <span asp-validation-for="Email" class="bfa-validation-message"></span>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="bfa-form-actions">
        <a class="bfa-btn-secondary bfa-admin-button"
           asp-area="Unidade"
           asp-controller="Alunos"
           asp-action="Detalhes"
           asp-route-unidadeId="@Model.UnidadeId"
           asp-route-alunoId="@Model.AlunoId">Cancelar</a>
        <button class="bfa-btn-primary bfa-admin-button" type="submit">Salvar alterações</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/bfa-input-masks.js" asp-append-version="true"></script>
}
