@using BFA.Domain.Alunos
@model ResponsavelFormViewModel
@{
    var isEdicao = Model.ResponsavelId.HasValue;
    ViewData["Title"] = isEdicao ? "Editar Responsável" : "Novo Responsável";
    Layout = "_UnidadeLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-form-responsavel">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Aluno · @Model.NomeUnidade</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-form-responsavel">@(isEdicao ? "Editar Responsável" : "Novo Responsável")</h1>
        <p class="bfa-admin-page-header__description">Preencha os dados do responsável para @(isEdicao ? "atualizar" : "cadastrar") o vínculo com @Model.NomeAluno.</p>
    </div>
</header>

<form class="bfa-admin-form"
      method="post"
      action="@(isEdicao
          ? $"/unidade/{Model.UnidadeId}/alunos/{Model.AlunoId}/responsaveis/{Model.ResponsavelId}/editar"
          : $"/unidade/{Model.UnidadeId}/alunos/{Model.AlunoId}/responsaveis/novo")">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="bfa-admin-notice bfa-admin-form-summary" role="alert"></div>

    <div class="bfa-admin-form-sections">
        <section class="bfa-admin-card bfa-admin-form-card">
            <header>
                <p>Dados do responsável</p>
                <h2>@Model.NomeAluno</h2>
            </header>
            <div class="bfa-professor-form-grid">
                <div class="bfa-form-field bfa-professor-form-wide">
                    <label asp-for="NomeCompleto" class="bfa-form-label"></label>
                    <input asp-for="NomeCompleto" class="form-control bfa-form-control" />
                    <span asp-validation-for="NomeCompleto" class="bfa-validation-message"></span>
                </div>
                <div class="bfa-form-field">
                    <label asp-for="Cpf" class="bfa-form-label"></label>
                    @if (isEdicao)
                    {
                        <input asp-for="Cpf"
                               class="form-control bfa-form-control"
                               inputmode="numeric"
                               readonly
                               disabled />
                        <span class="bfa-form-hint">CPF não pode ser alterado após o cadastro.</span>
                    }
                    else
                    {
                        <input asp-for="Cpf"
                               class="form-control bfa-form-control"
                               inputmode="numeric"
                               data-bfa-mask="cpf" />
                    }
                    <span asp-validation-for="Cpf" class="bfa-validation-message"></span>
                </div>
                <div class="bfa-form-field">
                    <label asp-for="Telefone" class="bfa-form-label"></label>
                    <input asp-for="Telefone"
                           class="form-control bfa-form-control"
                           inputmode="numeric"
                           data-bfa-mask="phone" />
                    <span asp-validation-for="Telefone" class="bfa-validation-message"></span>
                </div>
                <div class="bfa-form-field bfa-professor-form-wide">
                    <label asp-for="Email" class="bfa-form-label"></label>
                    <input asp-for="Email" class="form-control bfa-form-control" type="email" />
                    <span asp-validation-for="Email" class="bfa-validation-message"></span>
                </div>
            </div>
        </section>

        <section class="bfa-admin-card bfa-admin-form-card">
            <header>
                <p>Relação</p>
                <h2>Classificação do vínculo</h2>
            </header>
            <div class="bfa-professor-form-grid">
                <div class="bfa-form-field">
                    <label asp-for="TipoRelacao" class="bfa-form-label"></label>
                    <select asp-for="TipoRelacao"
                            asp-items="Html.GetEnumSelectList<TipoRelacaoResponsavel>()"
                            class="form-control bfa-form-control"
                            data-bfa-toggle="descricao-relacao"></select>
                    <span asp-validation-for="TipoRelacao" class="bfa-validation-message"></span>
                </div>
                <div class="bfa-form-field bfa-professor-form-wide"
                     id="descricao-relacao-field"
                     style="@(Model.TipoRelacao == TipoRelacaoResponsavel.Outro ? "" : "display:none")">
                    <label asp-for="DescricaoRelacao" class="bfa-form-label"></label>
                    <input asp-for="DescricaoRelacao" class="form-control bfa-form-control" />
                    <span asp-validation-for="DescricaoRelacao" class="bfa-validation-message"></span>
                </div>
                <div class="bfa-form-field">
                    <label class="bfa-form-label bfa-form-checkbox-label">
                        <input asp-for="PrincipalContato" class="bfa-form-checkbox" />
                        @Html.DisplayNameFor(m => m.PrincipalContato)
                    </label>
                </div>
                <div class="bfa-form-field">
                    <label class="bfa-form-label bfa-form-checkbox-label">
                        <input asp-for="ResponsavelFinanceiro" class="bfa-form-checkbox" />
                        @Html.DisplayNameFor(m => m.ResponsavelFinanceiro)
                    </label>
                </div>
            </div>
        </section>
    </div>

    <div class="bfa-admin-form-actions">
        <button class="bfa-btn-primary bfa-admin-button" type="submit">Salvar</button>
        <a class="bfa-btn-secondary bfa-admin-button"
           asp-area="Unidade"
           asp-controller="Alunos"
           asp-action="Responsaveis"
           asp-route-unidadeId="@Model.UnidadeId"
           asp-route-alunoId="@Model.AlunoId">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/bfa-input-masks.js" asp-append-version="true"></script>
    <script>
        (function () {
            var select = document.querySelector('[data-bfa-toggle="descricao-relacao"]');
            var field = document.getElementById('descricao-relacao-field');
            if (!select || !field) return;
            select.addEventListener('change', function () {
                field.style.display = select.value === '@((int)TipoRelacaoResponsavel.Outro)' ? '' : 'none';
            });
        })();
    </script>
}
