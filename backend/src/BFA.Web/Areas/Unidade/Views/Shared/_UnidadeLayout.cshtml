@using BFA.Web.ViewModels.Shared
@model IUnidadeContextoViewModel
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    var governanca = ViewData[GovernancaOperacionalUnidadeViewData.Chave]
        as GovernancaOperacionalUnidadeViewModel;
    ViewData[AdminShellViewData.Chave] = new AdminShellViewModel
    {
        AreaNome = "Unidade",
        ContextoNome = Model.NomeUnidade,
        HomeUrl = $"/unidade/{Model.UnidadeId:D}",
        HomeAriaLabel = $"Ir para a visão geral da Unidade {Model.NomeUnidade}",
        NavegacaoAriaLabel = $"Navegação da Unidade {Model.NomeUnidade}",
        NavegacaoTitulo = "Administração",
        MenuDescricao = "menu administrativo",
        NavegacaoPartial = "/Areas/Unidade/Views/Shared/_UnidadeNavLinks.cshtml",
        TrocarContextoUrl = Model.PodeTrocarUnidade ? "/selecionar-unidade" : null,
        TrocarContextoTexto = Model.PodeTrocarUnidade ? "Trocar unidade" : null,
        RetornoContextoUrl = governanca?.EhAdministradorRede == true
            ? "/franqueadora"
            : null,
        RetornoContextoTexto = governanca?.EhAdministradorRede == true
            ? "Voltar à rede"
            : null
    };
}

@if (governanca?.EhAdministradorRede == true)
{
    <p class="bfa-unidade-operation-context" role="status">
        @(governanca.PossuiFranqueadoAtivo
            ? "Unidade com operação sob responsabilidade do franqueado"
            : "Operação administrada pela Rede")
    </p>
}

@RenderBody()

@section AreaStyles {
    <link rel="stylesheet" href="~/css/unidade.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
