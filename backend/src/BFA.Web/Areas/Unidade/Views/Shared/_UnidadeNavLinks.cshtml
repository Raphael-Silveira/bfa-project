@{
    var caminhoAtual = Context.Request.Path.Value?.TrimEnd('/') ?? string.Empty;
    var unidadeId = Context.Request.RouteValues["unidadeId"]?.ToString();
    var rotaUnidade = $"/unidade/{unidadeId}";
    var rotaContrato = $"{rotaUnidade}/contrato";
    var rotaProfessores = $"{rotaUnidade}/professores";
    var rotaTurmas = $"{rotaUnidade}/turmas";
    var contratoAtivo = caminhoAtual.StartsWith(
        rotaContrato,
        StringComparison.OrdinalIgnoreCase);
    var professoresAtivo = caminhoAtual.StartsWith(
        rotaProfessores,
        StringComparison.OrdinalIgnoreCase);
    var turmasAtivo = caminhoAtual.StartsWith(
        rotaTurmas,
        StringComparison.OrdinalIgnoreCase);
    var visaoGeralAtiva = !contratoAtivo && !professoresAtivo && !turmasAtivo
        && caminhoAtual.Equals(rotaUnidade, StringComparison.OrdinalIgnoreCase);
}

<a class="bfa-admin-nav-link @(visaoGeralAtiva ? "is-active" : null)"
   href="@rotaUnidade"
   aria-current="@(visaoGeralAtiva ? "page" : null)">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 4h6v6H4z"></path>
        <path d="M14 4h6v6h-6z"></path>
        <path d="M4 14h6v6H4z"></path>
        <path d="M14 14h6v6h-6z"></path>
    </svg>
    <span>Visão Geral</span>
</a>

<a class="bfa-admin-nav-link @(professoresAtivo ? "is-active" : null)"
   href="@rotaProfessores"
   aria-current="@(professoresAtivo ? "page" : null)">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M19 8v6M16 11h6"></path>
    </svg>
    <span>Professores</span>
</a>

<a class="bfa-admin-nav-link @(turmasAtivo ? "is-active" : null)"
   href="@rotaTurmas"
   aria-current="@(turmasAtivo ? "page" : null)">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 5h16v14H4z"></path>
        <path d="M8 3v4M16 3v4M4 9h16M8 13h3M13 13h3M8 16h3"></path>
    </svg>
    <span>Turmas</span>
</a>

<a class="bfa-admin-nav-link @(contratoAtivo ? "is-active" : null)"
   href="@rotaContrato"
   aria-current="@(contratoAtivo ? "page" : null)">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6 3h9l3 3v15H6z"></path>
        <path d="M15 3v4h4M9 11h6M9 15h6"></path>
    </svg>
    <span>Contrato</span>
</a>
