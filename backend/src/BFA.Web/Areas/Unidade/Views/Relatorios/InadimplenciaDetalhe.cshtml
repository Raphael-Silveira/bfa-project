@model RelatorioInadimplenciaDetalheViewModel
@{
    ViewData["Title"] = "Inadimplência — Detalhe do Aluno";
    Layout = "_UnidadeLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-inadimplencia-detalhe">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Inadimplência</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-inadimplencia-detalhe">@Model.AlunoNome</h1>
        <p class="bfa-admin-page-header__description">
            Cobranças atrasadas — @Model.DiasEmAtraso dias em atraso.
        </p>
    </div>
</header>

<div class="bfa-admin-card-grid">
    <div class="bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__label">Valor Total Atrasado</div>
        <div class="bfa-admin-metric-card__value bfa-admin-metric-card__value--danger">@Model.ValorTotalAtrasado</div>
    </div>
    <div class="bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__label">Dias em Atraso</div>
        <div class="bfa-admin-metric-card__value">@Model.DiasEmAtraso dias</div>
    </div>
    <div class="bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__label">CPF</div>
        <div class="bfa-admin-metric-card__value">@(Model.AlunoCpf ?? "—")</div>
    </div>
</div>

@if (Model.Cobrancas.Count > 0)
{
    <div class="bfa-admin-card">
        <h2 class="bfa-admin-card__title">Cobranças Atrasadas</h2>
        <div class="bfa-admin-table-container bfa-admin-desktop-list">
            <table class="bfa-admin-table">
                <thead>
                    <tr>
                        <th>Descrição</th>
                        <th>Tipo</th>
                        <th>Valor</th>
                        <th>Pago</th>
                        <th>Saldo</th>
                        <th>Vencimento</th>
                        <th>Dias</th>
                        <th>Ação</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cobranca in Model.Cobrancas)
                    {
                        <tr>
                            <td>@cobranca.Descricao</td>
                            <td>@cobranca.Tipo</td>
                            <td>@cobranca.Valor</td>
                            <td>@cobranca.ValorPago</td>
                            <td>@cobranca.SaldoDevedor</td>
                            <td>@cobranca.DataVencimento</td>
                            <td>@cobranca.DiasAtraso dias</td>
                            <td class="bfa-admin-actions">
                                <a class="bfa-admin-icon-action"
                                   asp-area="Unidade"
                                   asp-controller="Cobrancas"
                                   asp-action="Detalhes"
                                   asp-route-unidadeId="@Model.UnidadeId"
                                   asp-route-cobrancaId="@cobranca.CobrancaId"
                                   title="Detalhes da cobrança">
                                    <span class="bfa-admin-icon-action__symbol" aria-hidden="true">i</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="bfa-admin-mobile-list">
            @foreach (var cobranca in Model.Cobrancas)
            {
                <a class="bfa-admin-mobile-list__item"
                   asp-area="Unidade"
                   asp-controller="Cobrancas"
                   asp-action="Detalhes"
                   asp-route-unidadeId="@Model.UnidadeId"
                   asp-route-cobrancaId="@cobranca.CobrancaId">
                    <div class="bfa-admin-mobile-list__header">
                        <span class="bfa-admin-mobile-list__name">@cobranca.Descricao</span>
                        <span class="bfa-admin-badge bfa-admin-badge--overdue">@cobranca.DiasAtraso dias</span>
                    </div>
                    <div class="bfa-admin-mobile-list__details">
                        <span>@cobranca.Tipo</span>
                        <span>@cobranca.SaldoDevedor</span>
                    </div>
                    <div class="bfa-admin-mobile-list__details">
                        <span>Venc: @cobranca.DataVencimento</span>
                    </div>
                </a>
            }
        </div>
    </div>
}

<div class="bfa-admin-form-actions">
    <a class="bfa-btn-secondary bfa-admin-button"
       asp-area="Unidade"
       asp-controller="Relatorios"
       asp-action="Inadimplencia"
       asp-route-unidadeId="@Model.UnidadeId">Voltar</a>
</div>
