@model RelatorioInadimplenciaDetalheViewModel
@{
    ViewData["Title"] = "Inadimplência — Detalhe do Aluno";
    Layout = "_UnidadeLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-inadimplencia-detalhe">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Inadimplência</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-inadimplencia-detalhe">@Model.AlunoNome</h1>
        <p class="bfa-admin-page-header__description">
            Cobranças atrasadas — @Model.DiasEmAtraso dias em atraso.
        </p>
    </div>
</header>

<section class="bfa-relatorio-hero bfa-relatorio-hero--detail" aria-label="Resumo da inadimplência do aluno">
    <div class="bfa-relatorio-hero__stats">
        <article class="bfa-relatorio-stat">
            <span class="bfa-relatorio-stat__label">Total atrasado</span>
            <strong class="bfa-relatorio-stat__value bfa-relatorio-stat__value--danger">@Model.ValorTotalAtrasado</strong>
            <span class="bfa-relatorio-stat__hint">saldo em cobrança</span>
        </article>
        <article class="bfa-relatorio-stat">
            <span class="bfa-relatorio-stat__label">Dias em atraso</span>
            <strong class="bfa-relatorio-stat__value">@Model.DiasEmAtraso dias</strong>
            <span class="bfa-relatorio-stat__hint">maior vencimento considerado</span>
        </article>
        <article class="bfa-relatorio-stat">
            <span class="bfa-relatorio-stat__label">CPF</span>
            <strong class="bfa-relatorio-stat__value">@(Model.AlunoCpf ?? "—")</strong>
            <span class="bfa-relatorio-stat__hint">documento cadastrado</span>
        </article>
    </div>
</section>

@if (Model.Cobrancas.Count > 0)
{
    <section class="bfa-relatorio-panel">
        <div class="bfa-relatorio-panel__header">
            <div>
                <h2 class="bfa-relatorio-panel__title">Cobranças atrasadas</h2>
                <p class="bfa-relatorio-panel__description">Detalhamento das cobranças em atraso deste aluno.</p>
            </div>
        </div>
        <div class="bfa-data-card bfa-relatorio-table-card bfa-admin-desktop-list">
            <div class="bfa-table-wrap">
                <table class="bfa-relatorio-table bfa-relatorio-detail-table">
                    <thead>
                        <tr>
                            <th scope="col">Descrição</th>
                            <th scope="col">Tipo</th>
                            <th class="bfa-relatorio-table__numeric" scope="col">Valor</th>
                            <th class="bfa-relatorio-table__numeric" scope="col">Pago</th>
                            <th class="bfa-relatorio-table__numeric" scope="col">Saldo</th>
                            <th scope="col">Vencimento</th>
                            <th class="bfa-relatorio-table__numeric" scope="col">Dias</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cobranca in Model.Cobrancas)
                        {
                            <tr>
                                <td>@cobranca.Descricao</td>
                                <td>@cobranca.Tipo</td>
                                <td class="bfa-relatorio-table__numeric">@cobranca.Valor</td>
                                <td class="bfa-relatorio-table__numeric">@cobranca.ValorPago</td>
                                <td class="bfa-relatorio-table__numeric">@cobranca.SaldoDevedor</td>
                                <td>@cobranca.DataVencimento</td>
                                <td class="bfa-relatorio-table__numeric">@cobranca.DiasAtraso dias</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bfa-mobile-card-list">
            @foreach (var cobranca in Model.Cobrancas)
            {
                <article class="bfa-mobile-card">
                    <div class="bfa-mobile-card__head">
                        <div>
                            <div class="bfa-data-primary">@cobranca.Descricao</div>
                            <div class="bfa-data-secondary">@cobranca.Tipo · Vencimento @cobranca.DataVencimento</div>
                        </div>
                        <span class="bfa-data-badge bfa-data-badge--overdue">@cobranca.DiasAtraso dias</span>
                    </div>
                    <div class="bfa-mobile-card__grid">
                        <div><span class="bfa-mobile-card__label">Valor</span><div>@cobranca.Valor</div></div>
                        <div><span class="bfa-mobile-card__label">Pago</span><div>@cobranca.ValorPago</div></div>
                        <div><span class="bfa-mobile-card__label">Saldo</span><div>@cobranca.SaldoDevedor</div></div>
                    </div>
                </article>
            }
        </div>
    </section>
}

<div class="bfa-admin-form-actions">
    <a class="bfa-btn-secondary bfa-admin-button"
       asp-area="Unidade"
       asp-controller="Relatorios"
       asp-action="Inadimplencia"
       asp-route-unidadeId="@Model.UnidadeId">Voltar</a>
</div>
