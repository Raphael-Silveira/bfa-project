@model RelatorioFinanceiroViewModel
@{
    ViewData["Title"] = "Relatório Financeiro";
    Layout = "_UnidadeLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-relatorio-financeiro">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Relatórios</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-relatorio-financeiro">Relatório Financeiro</h1>
        <p class="bfa-admin-page-header__description">
            Detalhamento financeiro de @Model.NomeUnidade.
        </p>
    </div>
</header>

<form class="bfa-admin-card bfa-matricula-filters"
      action="/unidade/@Model.UnidadeId/relatorios/financeiro"
      method="get"
      role="search">
    <div class="bfa-form-field">
        <label class="bfa-form-label" for="filtro-data-inicio">Data início</label>
        <input class="form-control bfa-form-control"
               id="filtro-data-inicio"
               name="dataInicio"
               type="date"
               value="@(Model.DataInicio?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="bfa-form-field">
        <label class="bfa-form-label" for="filtro-data-fim">Data fim</label>
        <input class="form-control bfa-form-control"
               id="filtro-data-fim"
               name="dataFim"
               type="date"
               value="@(Model.DataFim?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="bfa-matricula-filter-actions">
        <button class="bfa-btn-primary bfa-admin-button" type="submit">Filtrar</button>
        <a class="bfa-btn-secondary bfa-admin-button"
           asp-area="Unidade"
           asp-controller="Relatorios"
           asp-action="Financeiro"
           asp-route-unidadeId="@Model.UnidadeId">Limpar</a>
    </div>
</form>

<div class="bfa-admin-card-grid">
    <div class="bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__label">Receita</div>
        <div class="bfa-admin-metric-card__value bfa-admin-metric-card__value--success">@Model.TotalReceita</div>
    </div>
    <div class="bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__label">Pendente</div>
        <div class="bfa-admin-metric-card__value bfa-admin-metric-card__value--warning">@Model.TotalPendente</div>
    </div>
    <div class="bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__label">Atrasado</div>
        <div class="bfa-admin-metric-card__value bfa-admin-metric-card__value--danger">@Model.TotalAtrasado</div>
    </div>
</div>

@if (Model.PorTipo.Count > 0)
{
    <div class="bfa-admin-card">
        <h2 class="bfa-admin-card__title">Por Tipo</h2>
        <div class="bfa-admin-table-container">
            <table class="bfa-admin-table">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Quantidade</th>
                        <th>Valor Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tipo in Model.PorTipo)
                    {
                        <tr>
                            <td>@tipo.Tipo</td>
                            <td>@tipo.Quantidade</td>
                            <td>@tipo.Valor</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.PorStatus.Count > 0)
{
    <div class="bfa-admin-card">
        <h2 class="bfa-admin-card__title">Por Status</h2>
        <div class="bfa-admin-table-container">
            <table class="bfa-admin-table">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Quantidade</th>
                        <th>Valor</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var status in Model.PorStatus)
                    {
                        var statusClass = status.Status switch
                        {
                            "Pendente" => "bfa-admin-badge--pending",
                            "Paga" => "bfa-admin-badge--active",
                            "Atrasada" => "bfa-admin-badge--overdue",
                            "Cancelada" => "bfa-admin-badge--inactive",
                            _ => ""
                        };
                        <tr>
                            <td><span class="bfa-admin-badge @statusClass">@status.Status</span></td>
                            <td>@status.Quantidade</td>
                            <td>@status.Valor</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.PorPeriodo.Count > 0)
{
    <div class="bfa-admin-card">
        <h2 class="bfa-admin-card__title">Por Período</h2>
        <div class="bfa-admin-table-container">
            <table class="bfa-admin-table">
                <thead>
                    <tr>
                        <th>Mês</th>
                        <th>Receita</th>
                        <th>Pendente</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var periodo in Model.PorPeriodo)
                    {
                        <tr>
                            <td>@periodo.Periodo</td>
                            <td>@periodo.Receita</td>
                            <td>@periodo.Pendente</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="bfa-admin-form-actions">
    <a class="bfa-btn-secondary bfa-admin-button"
       asp-area="Unidade"
       asp-controller="Relatorios"
       asp-action="Index"
       asp-route-unidadeId="@Model.UnidadeId">Voltar</a>
</div>
