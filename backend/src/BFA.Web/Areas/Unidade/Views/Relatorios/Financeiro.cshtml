@model RelatorioFinanceiroViewModel
@{
    ViewData["Title"] = "Relatório Financeiro";
    Layout = "_UnidadeLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-relatorio-financeiro">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Relatórios</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-relatorio-financeiro">Relatório Financeiro</h1>
        <p class="bfa-admin-page-header__description">
            Detalhamento financeiro de @Model.NomeUnidade.
        </p>
    </div>
</header>

<section class="bfa-relatorio-hero" aria-labelledby="titulo-financeiro-resumo">
    <div class="bfa-relatorio-hero__copy">
        <p class="bfa-relatorio-hero__eyebrow">Resumo do período</p>
        <h2 class="bfa-relatorio-hero__title" id="titulo-financeiro-resumo">Leitura rápida do financeiro</h2>
        <p class="bfa-relatorio-hero__description">
            Receita, pendências e atrasos consolidados no período selecionado.
        </p>
    </div>
    <div class="bfa-relatorio-hero__stats" aria-label="Indicadores financeiros">
        <article class="bfa-relatorio-stat">
            <span class="bfa-relatorio-stat__label">Receita</span>
            <strong class="bfa-relatorio-stat__value">@Model.TotalReceita</strong>
            <span class="bfa-relatorio-stat__hint">total recebido</span>
        </article>
        <article class="bfa-relatorio-stat">
            <span class="bfa-relatorio-stat__label">Pendente</span>
            <strong class="bfa-relatorio-stat__value">@Model.TotalPendente</strong>
            <span class="bfa-relatorio-stat__hint">saldo em aberto</span>
        </article>
        <article class="bfa-relatorio-stat">
            <span class="bfa-relatorio-stat__label">Atrasado</span>
            <strong class="bfa-relatorio-stat__value">@Model.TotalAtrasado</strong>
            <span class="bfa-relatorio-stat__hint">valor em atraso</span>
        </article>
    </div>
</section>

<section class="bfa-relatorio-panel bfa-relatorio-filter-card" aria-labelledby="filtros-financeiro">
    <div class="bfa-relatorio-panel__header">
        <div>
            <h2 class="bfa-relatorio-panel__title" id="filtros-financeiro">Período</h2>
            <p class="bfa-relatorio-panel__description">Filtre o detalhamento financeiro por intervalo de datas.</p>
        </div>
    </div>

    <form class="bfa-matricula-filters"
          action="/unidade/@Model.UnidadeId/relatorios/financeiro"
          method="get"
          role="search">
        <div class="bfa-form-field">
            <label class="bfa-form-label" for="filtro-data-inicio">Data início</label>
            <input class="form-control bfa-form-control"
                   id="filtro-data-inicio"
                   name="dataInicio"
                   type="date"
                   value="@(Model.DataInicio?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="bfa-form-field">
            <label class="bfa-form-label" for="filtro-data-fim">Data fim</label>
            <input class="form-control bfa-form-control"
                   id="filtro-data-fim"
                   name="dataFim"
                   type="date"
                   value="@(Model.DataFim?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="bfa-matricula-filter-actions">
            <button class="bfa-btn-primary bfa-admin-button" type="submit">Filtrar</button>
            <a class="bfa-btn-secondary bfa-admin-button"
               asp-area="Unidade"
               asp-controller="Relatorios"
               asp-action="Financeiro"
               asp-route-unidadeId="@Model.UnidadeId">Limpar</a>
        </div>
    </form>
</section>

@if (Model.PorTipo.Count > 0)
{
    <section class="bfa-relatorio-panel">
        <div class="bfa-relatorio-panel__header">
            <div>
                <h2 class="bfa-relatorio-panel__title">Por tipo</h2>
                <p class="bfa-relatorio-panel__description">Composição do faturamento por modalidade de cobrança.</p>
            </div>
        </div>
        <div class="bfa-admin-table-container">
            <table class="bfa-admin-table">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Quantidade</th>
                        <th>Valor Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tipo in Model.PorTipo)
                    {
                        <tr>
                            <td>@tipo.Tipo</td>
                            <td>@tipo.Quantidade</td>
                            <td>@tipo.Valor</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model.PorStatus.Count > 0)
{
    <section class="bfa-relatorio-panel">
        <div class="bfa-relatorio-panel__header">
            <div>
                <h2 class="bfa-relatorio-panel__title">Por status</h2>
                <p class="bfa-relatorio-panel__description">Distribuição dos valores por situação da cobrança.</p>
            </div>
        </div>
        <div class="bfa-admin-table-container">
            <table class="bfa-admin-table">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Quantidade</th>
                        <th>Valor</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var status in Model.PorStatus)
                    {
                        var statusClass = status.Status switch
                        {
                            "Pendente" => "bfa-admin-badge--pending",
                            "Paga" => "bfa-admin-badge--active",
                            "Atrasada" => "bfa-admin-badge--overdue",
                            "Cancelada" => "bfa-admin-badge--inactive",
                            _ => ""
                        };
                        <tr>
                            <td><span class="bfa-admin-badge @statusClass">@status.Status</span></td>
                            <td>@status.Quantidade</td>
                            <td>@status.Valor</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model.PorPeriodo.Count > 0)
{
    <section class="bfa-relatorio-panel">
        <div class="bfa-relatorio-panel__header">
            <div>
                <h2 class="bfa-relatorio-panel__title">Por período</h2>
                <p class="bfa-relatorio-panel__description">Evolução mensal de receita e pendência.</p>
            </div>
        </div>
        <div class="bfa-admin-table-container">
            <table class="bfa-admin-table">
                <thead>
                    <tr>
                        <th>Mês</th>
                        <th>Receita</th>
                        <th>Pendente</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var periodo in Model.PorPeriodo)
                    {
                        <tr>
                            <td>@periodo.Periodo</td>
                            <td>@periodo.Receita</td>
                            <td>@periodo.Pendente</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<div class="bfa-admin-form-actions">
    <a class="bfa-btn-secondary bfa-admin-button"
       asp-area="Unidade"
       asp-controller="Relatorios"
       asp-action="Index"
       asp-route-unidadeId="@Model.UnidadeId">Voltar</a>
</div>
