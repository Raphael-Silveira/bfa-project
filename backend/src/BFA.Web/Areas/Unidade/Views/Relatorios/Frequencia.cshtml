@model AulaFrequenciaViewModel
@{
    ViewData["Title"] = "Frequência";
    Layout = "_UnidadeLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-frequencia">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Relatórios</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-frequencia">Relatório de Frequência</h1>
        <p class="bfa-admin-page-header__description">
            Frequência dos alunos em @Model.NomeUnidade.
        </p>
    </div>
</header>

<section class="bfa-relatorio-panel bfa-relatorio-filter-card" aria-labelledby="filtros-frequencia">
    <div class="bfa-relatorio-panel__header">
        <div>
            <h2 class="bfa-relatorio-panel__title" id="filtros-frequencia">Período</h2>
            <p class="bfa-relatorio-panel__description">Filtre o detalhamento de frequência por intervalo de datas.</p>
        </div>
    </div>

    <form class="bfa-matricula-filters"
          method="get"
          action="/unidade/@Model.UnidadeId/relatorios/frequencia"
          role="search">
        <div class="bfa-form-field">
            <label class="bfa-form-label" for="filtro-data-inicio">Data início</label>
            <div class="bfa-admin-date-field" data-bfa-date-field>
                <input class="form-control bfa-form-control"
                       id="filtro-data-inicio"
                       name="dataInicio"
                       type="text"
                       inputmode="numeric"
                       autocomplete="off"
                       placeholder="dd/mm/aaaa"
                       maxlength="10"
                       data-bfa-date-input
                       value="@Model.DataInicio.ToString("dd/MM/yyyy")" />
                <button class="bfa-admin-date-field__trigger"
                        type="button"
                        aria-label="Abrir calendário da data inicial"
                        title="Abrir calendário"
                        data-bfa-date-trigger>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"></path></svg>
                </button>
            </div>
        </div>
        <div class="bfa-form-field">
            <label class="bfa-form-label" for="filtro-data-fim">Data fim</label>
            <div class="bfa-admin-date-field" data-bfa-date-field>
                <input class="form-control bfa-form-control"
                       id="filtro-data-fim"
                       name="dataFim"
                       type="text"
                       inputmode="numeric"
                       autocomplete="off"
                       placeholder="dd/mm/aaaa"
                       maxlength="10"
                       data-bfa-date-input
                       value="@Model.DataFim.ToString("dd/MM/yyyy")" />
                <button class="bfa-admin-date-field__trigger"
                        type="button"
                        aria-label="Abrir calendário da data final"
                        title="Abrir calendário"
                        data-bfa-date-trigger>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"></path></svg>
                </button>
            </div>
        </div>
        <div class="bfa-matricula-filter-actions">
            <button class="bfa-btn-primary bfa-admin-button" type="submit">Filtrar</button>
            <a class="bfa-btn-secondary bfa-admin-button"
               asp-area="Unidade"
               asp-controller="Relatorios"
               asp-action="Frequencia"
               asp-route-unidadeId="@Model.UnidadeId">Limpar</a>
        </div>
    </form>
</section>

@if (Model.Alunos.Count == 0)
{
    <section class="bfa-admin-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            <h2>Nenhum dado de frequência encontrado.</h2>
            <p>Registre chamadas para gerar o relatório de frequência.</p>
        </div>
    </section>
}

else
{
    <div class="bfa-data-card bfa-admin-desktop-list">
        <div class="bfa-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>Total Aulas</th>
                        <th>Presentes</th>
                        <th>Ausentes</th>
                        <th>Justificados</th>
                        <th>Isentos</th>
                        <th>Frequência</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Alunos)
                {
                    var percentual = decimal.Parse(item.PercentualFrequencia.Replace("%", ""));
                    <tr>
                        <td>
                            <div class="bfa-data-primary">@item.NomeCompleto</div>
                        </td>
                        <td>@item.TotalAulas</td>
                        <td>@item.Presentes</td>
                        <td>@item.Ausentes</td>
                        <td>@item.Justificados</td>
                        <td>@item.Isentos</td>
                        <td>
                            <span class="bfa-data-badge @(percentual >= 75 ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                                <i class="bfa-data-badge__dot"></i>
                                @item.PercentualFrequencia
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <section class="bfa-mobile-card-list" aria-label="Frequência dos alunos">
        @foreach (var item in Model.Alunos)
        {
            var percentual = decimal.Parse(item.PercentualFrequencia.Replace("%", ""));
            <article class="bfa-mobile-card">
                <div class="bfa-mobile-card__head">
                    <div>
                        <div class="bfa-data-primary">@item.NomeCompleto</div>
                    </div>
                    <span class="bfa-data-badge @(percentual >= 75 ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                        <i class="bfa-data-badge__dot"></i>
                        @item.PercentualFrequencia
                    </span>
                </div>
                <div class="bfa-mobile-card__grid">
                    <div>
                        <span class="bfa-mobile-card__label">Total</span>
                        <div>@item.TotalAulas aulas</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Presentes</span>
                        <div>@item.Presentes</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Ausentes</span>
                        <div>@item.Ausentes</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Justificados</span>
                        <div>@item.Justificados</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Isentos</span>
                        <div>@item.Isentos</div>
                    </div>
                </div>
            </article>
        }
    </section>
}

@section Scripts {
    <script src="~/js/bfa-date-field.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('[data-bfa-date-field]').forEach(function (el) {
            BFADateField.init(el);
        });
    </script>
}
