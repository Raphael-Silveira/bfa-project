@model RelatorioInadimplenciaViewModel
@{
    ViewData["Title"] = "Relatório de Inadimplência";
    Layout = "_UnidadeLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-inadimplencia">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Relatórios</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-inadimplencia">Relatório de Inadimplência</h1>
        <p class="bfa-admin-page-header__description">
            Alunos com cobranças atrasadas em @Model.NomeUnidade.
        </p>
    </div>
</header>

<section class="bfa-relatorio-hero" aria-labelledby="titulo-inadimplencia-resumo">
    <div class="bfa-relatorio-hero__copy">
        <p class="bfa-relatorio-hero__eyebrow">Saúde da carteira</p>
        <h2 class="bfa-relatorio-hero__title" id="titulo-inadimplencia-resumo">Visão consolidada da inadimplência</h2>
        <p class="bfa-relatorio-hero__description">
            Acompanhe saldo em atraso, quantidade de alunos com débito e a distribuição por faixa.
        </p>
    </div>
    <div class="bfa-relatorio-hero__stats" aria-label="Indicadores de inadimplência">
        <article class="bfa-relatorio-stat bfa-relatorio-stat--wide">
            <span class="bfa-relatorio-stat__label">Total atrasado</span>
            <strong class="bfa-relatorio-stat__value">@Model.TotalAtrasado</strong>
            <span class="bfa-relatorio-stat__hint">saldo em cobrança</span>
        </article>
        <article class="bfa-relatorio-stat">
            <span class="bfa-relatorio-stat__label">Alunos com débito</span>
            <strong class="bfa-relatorio-stat__value">@Model.TotalAlunos</strong>
            <span class="bfa-relatorio-stat__hint">quantidade de alunos</span>
        </article>
    </div>
</section>

@if (Model.PorFaixa.Count > 0)
{
    <section class="bfa-relatorio-panel">
        <div class="bfa-relatorio-panel__header">
            <div>
                <h2 class="bfa-relatorio-panel__title">Por faixa de atraso</h2>
                <p class="bfa-relatorio-panel__description">Concentração do saldo por tempo de atraso.</p>
            </div>
        </div>
        <div class="bfa-relatorio-grid bfa-relatorio-grid--cards">
            @foreach (var faixa in Model.PorFaixa)
            {
                <article class="bfa-relatorio-mini-card">
                    <span class="bfa-relatorio-mini-card__label">@faixa.Faixa</span>
                    <strong class="bfa-relatorio-mini-card__value">@faixa.QuantidadeAlunos</strong>
                    <span class="bfa-relatorio-mini-card__meta">alunos · @faixa.ValorTotal</span>
                </article>
            }
        </div>
    </section>
}

@if (Model.Alunos.Count == 0)
{
    <section class="bfa-admin-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            <h2>Nenhuma inadimplência encontrada.</h2>
            <p>Todas as cobranças estão em dia.</p>
        </div>
    </section>
}
else
{
    <section class="bfa-relatorio-panel bfa-admin-desktop-list">
        <div class="bfa-relatorio-panel__header">
            <div>
                <h2 class="bfa-relatorio-panel__title">Alunos inadimplentes</h2>
                <p class="bfa-relatorio-panel__description">Lista consolidada dos alunos com cobranças atrasadas.</p>
            </div>
        </div>
        <div class="bfa-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>CPF</th>
                        <th>Cobranças</th>
                        <th>Valor Total</th>
                        <th>Dias em Atraso</th>
                        <th>Faixa</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var aluno in Model.Alunos)
                {
                    <tr>
                        <td>
                            <div class="bfa-data-primary">@aluno.NomeCompleto</div>
                        </td>
                        <td>@(aluno.Cpf ?? "—")</td>
                        <td>@aluno.CobrancasAtrasadas</td>
                        <td>
                            <div class="bfa-data-primary">@aluno.ValorTotalAtrasado</div>
                        </td>
                        <td>@aluno.DiasEmAtraso dias</td>
                        <td>
                            <span class="bfa-data-badge bfa-data-badge--overdue">
                                <i class="bfa-data-badge__dot"></i>
                                @aluno.FaixaAtraso
                            </span>
                        </td>
                        <td>
                            <div class="bfa-actions-cell">
                                <a class="bfa-admin-button bfa-btn-secondary"
                                   asp-area="Unidade"
                                   asp-controller="Relatorios"
                                   asp-action="InadimplenciaDetalhe"
                                   asp-route-unidadeId="@Model.UnidadeId"
                                   asp-route-alunoId="@aluno.AlunoId">Detalhes</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="bfa-mobile-card-list" aria-label="Alunos inadimplentes">
        @foreach (var aluno in Model.Alunos)
        {
            <article class="bfa-mobile-card">
                <div class="bfa-mobile-card__head">
                    <div>
                        <div class="bfa-data-primary">@aluno.NomeCompleto</div>
                        <div class="bfa-data-secondary">CPF: @(aluno.Cpf ?? "—")</div>
                    </div>
                    <span class="bfa-data-badge bfa-data-badge--overdue">
                        <i class="bfa-data-badge__dot"></i>
                        @aluno.DiasEmAtraso dias
                    </span>
                </div>
                <div class="bfa-mobile-card__grid">
                    <div>
                        <span class="bfa-mobile-card__label">Cobranças</span>
                        <div>@aluno.CobrancasAtrasadas</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Valor Total</span>
                        <div>@aluno.ValorTotalAtrasado</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Faixa</span>
                        <div>@aluno.FaixaAtraso</div>
                    </div>
                </div>
                <div class="bfa-mobile-card__actions">
                    <a class="bfa-admin-button bfa-btn-secondary"
                       asp-area="Unidade"
                       asp-controller="Relatorios"
                       asp-action="InadimplenciaDetalhe"
                       asp-route-unidadeId="@Model.UnidadeId"
                       asp-route-alunoId="@aluno.AlunoId">Detalhes</a>
                </div>
            </article>
        }
    </section>
}

<div class="bfa-admin-form-actions">
    <a class="bfa-btn-secondary bfa-admin-button"
       asp-area="Unidade"
       asp-controller="Relatorios"
       asp-action="Index"
       asp-route-unidadeId="@Model.UnidadeId">Voltar</a>
</div>
