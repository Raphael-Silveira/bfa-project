@using BFA.Web.ViewModels.Shared
@model AulasListaViewModel
@{
    ViewData["Title"] = "Aulas";
    Layout = "_UnidadeLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-aulas">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Operação da unidade</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-aulas">Aulas</h1>
        <p class="bfa-admin-page-header__description">
            Consulte as aulas programadas em @Model.NomeUnidade.
        </p>
    </div>
    <div class="bfa-admin-page-header__actions">
        @if (Model.PodeGerenciar)
        {
            <a class="bfa-btn-primary bfa-admin-button"
               asp-area="Unidade"
               asp-controller="Aulas"
               asp-action="Nova"
               asp-route-unidadeId="@Model.UnidadeId">Nova aula</a>
        }
    </div>
</header>

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="bfa-admin-notice" role="status"><strong>@sucesso</strong></div>
}

<section class="bfa-period-filter" aria-label="Filtro por período">
    <div class="bfa-period-filter__quick-filters">
        @{
            var hoje = DateOnly.FromDateTime(DateTime.Today);
            var inicioSemana = hoje.AddDays(-(int)hoje.DayOfWeek + 1);
            var fimSemana = inicioSemana.AddDays(6);
            var inicioMes = new DateOnly(hoje.Year, hoje.Month, 1);
            var fimMes = inicioMes.AddMonths(1).AddDays(-1);
        }
        <a class="bfa-period-filter__quick-filter @(Model.DataInicio == hoje && Model.DataFim == hoje ? "is-active" : "")"
           href="/unidade/@Model.UnidadeId/aulas?dataInicio=@hoje.ToString("yyyy-MM-dd")&dataFim=@hoje.ToString("yyyy-MM-dd")">Hoje</a>
        <a class="bfa-period-filter__quick-filter @(Model.DataInicio == inicioSemana && Model.DataFim == fimSemana ? "is-active" : "")"
           href="/unidade/@Model.UnidadeId/aulas?dataInicio=@inicioSemana.ToString("yyyy-MM-dd")&dataFim=@fimSemana.ToString("yyyy-MM-dd")">Esta semana</a>
        <a class="bfa-period-filter__quick-filter @(Model.DataInicio == inicioMes && Model.DataFim == fimMes ? "is-active" : "")"
           href="/unidade/@Model.UnidadeId/aulas?dataInicio=@inicioMes.ToString("yyyy-MM-dd")&dataFim=@fimMes.ToString("yyyy-MM-dd")">Este mês</a>
    </div>
    <form class="bfa-period-filter__form" method="get" action="/unidade/@Model.UnidadeId/aulas">
        <div class="bfa-period-filter__row">
            <div class="bfa-period-filter__field">
                <label class="bfa-form-label" for="filtro-data-inicio">Data inicial</label>
                <input class="bfa-form-control"
                       id="filtro-data-inicio"
                       name="dataInicio"
                       type="date"
                       value="@Model.DataInicio.ToString("yyyy-MM-dd")" />
            </div>
            <span class="bfa-period-filter__separator">até</span>
            <div class="bfa-period-filter__field">
                <label class="bfa-form-label" for="filtro-data-fim">Data final</label>
                <input class="bfa-form-control"
                       id="filtro-data-fim"
                       name="dataFim"
                       type="date"
                       value="@Model.DataFim.ToString("yyyy-MM-dd")" />
            </div>
            <div class="bfa-period-filter__actions">
                <button class="bfa-btn-primary bfa-admin-button" type="submit">Filtrar</button>
                <a class="bfa-btn-secondary bfa-admin-button"
                   href="/unidade/@Model.UnidadeId/aulas">Limpar</a>
            </div>
        </div>
    </form>
</section>

@if (Model.Aulas.Count == 0)
{
    <section class="bfa-admin-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            <h2>Nenhuma aula encontrada neste período.</h2>
            <p>Ajuste o período ou programe novas aulas.</p>
        </div>
    </section>
}
else
{
    <div class="bfa-data-card bfa-admin-desktop-list">
        <div class="bfa-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Horário</th>
                        <th>Turma</th>
                        <th>Professor</th>
                        <th>Inscritos</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Aulas)
                {
                    <tr>
                        <td>
                            <div class="bfa-data-primary">@item.Data</div>
                        </td>
                        <td>@item.HoraInicio – @item.HoraFim</td>
                        <td>
                            <div class="bfa-data-primary">@item.TurmaNome</div>
                        </td>
                        <td>@item.ProfessorNome</td>
                        <td>@item.Inscritos / @item.Capacidade</td>
                        <td>
                            @{
                                var badgeClass = item.Status switch
                                {
                                    "Programada" => "bfa-data-badge--active",
                                    "Concluida" => "bfa-data-badge--completed",
                                    _ => "bfa-data-badge--inactive"
                                };
                            }
                            <span class="bfa-data-badge @badgeClass">
                                <i class="bfa-data-badge__dot"></i>
                                @item.Status
                            </span>
                        </td>
                        <td>
                            <div class="bfa-actions-cell">
                                <a class="bfa-admin-button bfa-btn-secondary"
                                   asp-area="Unidade"
                                   asp-controller="Aulas"
                                   asp-action="Detalhes"
                                   asp-route-unidadeId="@Model.UnidadeId"
                                   asp-route-aulaId="@item.AulaId">Detalhes</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="bfa-table-footer">
            @{
                var totalPaginas = (int)Math.Ceiling((double)Model.TotalItens / Model.TamanhoPagina);
                var primeiroIndice = Model.TotalItens == 0 ? 0 : (Model.PaginaAtual - 1) * Model.TamanhoPagina + 1;
                var ultimoIndice = Math.Min(Model.PaginaAtual * Model.TamanhoPagina, Model.TotalItens);
                var baseQueryString = $"dataInicio={Model.DataInicio:yyyy-MM-dd}&dataFim={Model.DataFim:yyyy-MM-dd}";
                var paginacao = new PaginacaoViewModel
                {
                    PaginaAtual = Model.PaginaAtual,
                    TotalPaginas = totalPaginas,
                    TotalItens = Model.TotalItens,
                    PrimeiroIndice = primeiroIndice,
                    UltimoIndice = ultimoIndice,
                    BaseQueryString = baseQueryString
                };
            }
            <div>Mostrando <strong>@primeiroIndice–@ultimoIndice</strong> de <strong>@Model.TotalItens</strong> aulas</div>
            <partial name="_Paginacao" model="paginacao" />
        </div>
    </div>

    <section class="bfa-mobile-card-list" aria-label="Aulas da unidade">
        @foreach (var item in Model.Aulas)
        {
            var badgeClass = item.Status switch
            {
                "Programada" => "bfa-data-badge--active",
                "Concluida" => "bfa-data-badge--completed",
                _ => "bfa-data-badge--inactive"
            };
            <article class="bfa-mobile-card">
                <div class="bfa-mobile-card__head">
                    <div>
                        <div class="bfa-data-primary">@item.TurmaNome</div>
                        <div class="bfa-data-secondary">@item.Data · @item.HoraInicio – @item.HoraFim</div>
                    </div>
                    <span class="bfa-data-badge @badgeClass">
                        <i class="bfa-data-badge__dot"></i>
                        @item.Status
                    </span>
                </div>
                <div class="bfa-mobile-card__grid">
                    <div>
                        <span class="bfa-mobile-card__label">Professor</span>
                        <div>@item.ProfessorNome</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Inscritos</span>
                        <div>@item.Inscritos / @item.Capacidade</div>
                    </div>
                </div>
                <div class="bfa-mobile-card__actions">
                    <a class="bfa-admin-button bfa-btn-secondary"
                       asp-area="Unidade"
                       asp-controller="Aulas"
                       asp-action="Detalhes"
                       asp-route-unidadeId="@Model.UnidadeId"
                       asp-route-aulaId="@item.AulaId">Detalhes</a>
                </div>
            </article>
        }
    </section>
}
