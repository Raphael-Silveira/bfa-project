@model AulasListaViewModel
@{
    ViewData["Title"] = "Aulas";
    Layout = "_UnidadeLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-aulas">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Operação da unidade</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-aulas">Aulas</h1>
        <p class="bfa-admin-page-header__description">
            Consulte as aulas programadas em @Model.NomeUnidade.
        </p>
    </div>
    @if (Model.PodeGerenciar)
    {
        <a class="bfa-btn-primary bfa-admin-button"
           asp-area="Unidade"
           asp-controller="Aulas"
           asp-action="Nova"
           asp-route-unidadeId="@Model.UnidadeId">Nova aula</a>
    }
</header>

<form class="bfa-admin-card bfa-matricula-filters"
      action="/unidade/@Model.UnidadeId/aulas"
      method="get"
      role="search">
    <div class="bfa-form-field">
        <label class="bfa-form-label" for="filtro-data-inicio">Data início</label>
        <input class="form-control bfa-form-control"
               id="filtro-data-inicio"
               name="dataInicio"
               type="date"
               value="@Model.DataInicio.ToString("yyyy-MM-dd")" />
    </div>
    <div class="bfa-form-field">
        <label class="bfa-form-label" for="filtro-data-fim">Data fim</label>
        <input class="form-control bfa-form-control"
               id="filtro-data-fim"
               name="dataFim"
               type="date"
               value="@Model.DataFim.ToString("yyyy-MM-dd")" />
    </div>
    <div class="bfa-matricula-filter-actions">
        <button class="bfa-btn-primary bfa-admin-button" type="submit">Filtrar</button>
        <a class="bfa-btn-secondary bfa-admin-button"
           asp-area="Unidade"
           asp-controller="Aulas"
           asp-action="Index"
           asp-route-unidadeId="@Model.UnidadeId">Limpar</a>
    </div>
</form>

@if (Model.Aulas.Count == 0)
{
    <section class="bfa-admin-empty-state bfa-unidade-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            <h2>Nenhuma aula encontrada neste período.</h2>
            <p>Ajuste o período ou programe novas aulas.</p>
        </div>
    </section>
}
else
{
    <div class="bfa-admin-table-container bfa-admin-desktop-list">
        <table class="bfa-admin-table">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Horário</th>
                    <th>Turma</th>
                    <th>Professor</th>
                    <th>Inscritos</th>
                    <th>Status</th>
                    <th>Ação</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Aulas)
            {
                <tr>
                    <td>@item.Data</td>
                    <td>@item.HoraInicio – @item.HoraFim</td>
                    <td><strong>@item.TurmaNome</strong></td>
                    <td>@item.ProfessorNome</td>
                    <td>@item.Inscritos / @item.Capacidade</td>
                    <td>
                        <span class="bfa-admin-badge @(item.Status == "Programada" ? "is-active" : item.Status == "Concluida" ? "is-completed" : "is-inactive")">
                            @item.Status
                        </span>
                    </td>
                    <td>
                        <a class="bfa-btn-secondary bfa-admin-button"
                           asp-area="Unidade"
                           asp-controller="Aulas"
                           asp-action="Detalhes"
                           asp-route-unidadeId="@Model.UnidadeId"
                           asp-route-aulaId="@item.AulaId">Ver detalhes <span aria-hidden="true">→</span></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <section class="bfa-admin-mobile-list" aria-label="Aulas da unidade">
        @foreach (var item in Model.Aulas)
        {
            <article class="bfa-admin-card">
                <header>
                    <div>
                        <p>@item.Data</p>
                        <h2>@item.TurmaNome</h2>
                        <span>@item.HoraInicio – @item.HoraFim</span>
                    </div>
                    <span class="bfa-admin-badge @(item.Status == "Programada" ? "is-active" : item.Status == "Concluida" ? "is-completed" : "is-inactive")">
                        @item.Status
                    </span>
                </header>
                <dl>
                    <div><dt>Professor</dt><dd>@item.ProfessorNome</dd></div>
                    <div><dt>Inscritos</dt><dd>@item.Inscritos / @item.Capacidade</dd></div>
                </dl>
                <footer>
                    <a class="bfa-btn-secondary bfa-admin-button"
                       asp-area="Unidade"
                       asp-controller="Aulas"
                       asp-action="Detalhes"
                       asp-route-unidadeId="@Model.UnidadeId"
                       asp-route-aulaId="@item.AulaId">Ver detalhes <span aria-hidden="true">→</span></a>
                </footer>
            </article>
        }
    </section>
}
