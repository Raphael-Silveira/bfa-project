@using System.Globalization
@model PainelUnidadeViewModel

@{
    ViewData["Title"] = "Visão Geral";
    Layout = "_UnidadeLayout";
}

<header class="bfa-unidade-welcome" aria-labelledby="titulo-painel-unidade">
    <div class="bfa-unidade-welcome__copy">
        <p class="bfa-unidade-welcome__eyebrow">Bem-vindo à sua unidade</p>
        <h1 class="bfa-unidade-welcome__title" id="titulo-painel-unidade">@Model.NomeUnidade</h1>
        <p class="bfa-unidade-welcome__subtitle">Visão geral da operação da Unidade.</p>
    </div>
    <aside class="bfa-unidade-welcome__quote" aria-label="Frase motivacional">
        <blockquote>
            <p>&ldquo;Disciplina hoje,<br>resultados sempre.&rdquo;</p>
            <footer>BFA</footer>
        </blockquote>
    </aside>
</header>

<section class="bfa-admin-card-grid" aria-label="Métricas operacionais">
    <article class="bfa-admin-card bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="bfa-admin-metric-card__body">
            <span class="bfa-admin-metric-card__label">Alunos ativos</span>
            <strong class="bfa-admin-metric-card__value">@Model.TotalAlunosAtivos</strong>
            <a class="bfa-admin-metric-card__link" href="/unidade/@Model.UnidadeId/alunos">Ver alunos <span>&rarr;</span></a>
        </div>
    </article>
    <article class="bfa-admin-card bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div class="bfa-admin-metric-card__body">
            <span class="bfa-admin-metric-card__label">Turmas ativas</span>
            <strong class="bfa-admin-metric-card__value">@Model.TotalTurmasAtivas</strong>
            <a class="bfa-admin-metric-card__link" href="/unidade/@Model.UnidadeId/turmas">Ver turmas <span>&rarr;</span></a>
        </div>
    </article>
    <article class="bfa-admin-card bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
        </div>
        <div class="bfa-admin-metric-card__body">
            <span class="bfa-admin-metric-card__label">Aulas esta semana</span>
            <strong class="bfa-admin-metric-card__value">@Model.TotalAulasSemana</strong>
            <a class="bfa-admin-metric-card__link" href="/unidade/@Model.UnidadeId/aulas">Ver aulas <span>&rarr;</span></a>
        </div>
    </article>
    <article class="bfa-admin-card bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <div class="bfa-admin-metric-card__body">
            <span class="bfa-admin-metric-card__label">Frequência média</span>
            <strong class="bfa-admin-metric-card__value bfa-admin-metric-card__value--accent">@Model.FrequenciaMedia</strong>
            <a class="bfa-admin-metric-card__link" href="/unidade/@Model.UnidadeId/relatorios">Ver relatório <span>&rarr;</span></a>
        </div>
    </article>
</section>

<section class="bfa-admin-card-grid" aria-label="Métricas financeiras">
    <article class="bfa-admin-card bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div class="bfa-admin-metric-card__body">
            <span class="bfa-admin-metric-card__label">Receita mensal</span>
            <strong class="bfa-admin-metric-card__value bfa-admin-metric-card__value--accent">@Model.ReceitaMes</strong>
        </div>
    </article>
    <article class="bfa-admin-card bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="bfa-admin-metric-card__body">
            <span class="bfa-admin-metric-card__label">Pendente</span>
            <strong class="bfa-admin-metric-card__value">@Model.Pendente</strong>
        </div>
    </article>
    <article class="bfa-admin-card bfa-admin-metric-card">
        <div class="bfa-admin-metric-card__icon bfa-admin-metric-card__icon--danger">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <div class="bfa-admin-metric-card__body">
            <span class="bfa-admin-metric-card__label">Em atraso</span>
            <strong class="bfa-admin-metric-card__value bfa-admin-metric-card__value--danger">@Model.EmAtraso</strong>
        </div>
    </article>
</section>

<div class="bfa-unidade-dashboard-grid">
    <section class="bfa-unidade-schedule-panel" aria-label="Próximas aulas">
        <div class="bfa-unidade-schedule-panel__header">
            <h2>Próximas aulas de hoje</h2>
            <a href="/unidade/@Model.UnidadeId/aulas">Ver todas as aulas <span>&rarr;</span></a>
        </div>

        @if (Model.AulasHoje.Count == 0)
        {
            <div class="bfa-unidade-empty-hint">Nenhuma aula programada para hoje.</div>
        }
        else
        {
            @foreach (var aula in Model.AulasHoje)
            {
                <div class="bfa-unidade-lesson-row">
                    <time>@aula.Horario</time>
                    <span class="bfa-unidade-lesson-dot @aula.DotClass"></span>
                    <div class="bfa-unidade-lesson-main">
                        <strong>@aula.TurmaNome</strong>
                        <span>Prof. @aula.ProfessorNome</span>
                    </div>
                    <div class="bfa-unidade-lesson-capacity">
                        <strong>@aula.Inscritos/@aula.Capacidade</strong>
                        <span>alunos</span>
                    </div>
                    <a class="bfa-btn-secondary" href="/unidade/@Model.UnidadeId/aulas">Ver detalhes</a>
                </div>
            }
        }
    </section>

    <section class="bfa-unidade-activity-panel" aria-label="Atividades recentes">
        <div class="bfa-unidade-activity-panel__header">
            <h2>Atividades recentes</h2>
        </div>

        @if (Model.AtividadesRecentes.Count == 0)
        {
            <div class="bfa-unidade-empty-hint">Nenhuma atividade registrada.</div>
        }
        else
        {
            @foreach (var atividade in Model.AtividadesRecentes)
            {
                var (iconSvg, iconClass) = atividade.IconeTipo switch
                {
                    "matricula" => ("<line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"/><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/>", "bfa-unidade-activity-icon--success"),
                    "turma" => ("<rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/>", "bfa-unidade-activity-icon--warning"),
                    "professor" => ("<path d=\"M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"8.5\" cy=\"7\" r=\"4\"/><line x1=\"20\" y1=\"8\" x2=\"20\" y2=\"14\"/><line x1=\"23\" y1=\"11\" x2=\"17\" y2=\"11\"/>", "bfa-unidade-activity-icon--info"),
                    _ => ("<path d=\"M4 5h16v14H4z\"/><path d=\"M8 9h8M8 13h5M8 17h3\"/>", "bfa-unidade-activity-icon--neutral")
                };
                <div class="bfa-unidade-activity-row">
                    <div class="bfa-unidade-activity-icon @iconClass">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(iconSvg)</svg>
                    </div>
                    <div class="bfa-unidade-activity-copy">
                        <strong>@atividade.Titulo</strong>
                        <span>@atividade.Subtitulo</span>
                    </div>
                    <time>@atividade.TempoRelativo</time>
                </div>
            }
        }
    </section>
</div>

@functions {
    private static string FormatarVigencia(DateOnly inicio, DateOnly? fim) =>
        fim is { } dataFim
            ? $"{inicio:dd/MM/yyyy} a {dataFim:dd/MM/yyyy}"
            : $"A partir de {inicio:dd/MM/yyyy}";

    private static string FormatarMoedaOpcional(decimal? valor) =>
        valor is { } moeda ? moeda.ToString("C", CulturaPtBr) : "Não informada";

    private static string FormatarVencimento(int? dia) =>
        dia is { } valor ? $"Dia {valor}" : "Não informado";

    private static readonly CultureInfo CulturaPtBr = CultureInfo.GetCultureInfo("pt-BR");
}
