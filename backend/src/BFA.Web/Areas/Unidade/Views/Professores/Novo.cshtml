@using BFA.Domain.Professores
@model ProfessorUnidadeNovoViewModel
@{
    ViewData["Title"] = "Novo professor";
    Layout = "_UnidadeLayout";
}

<header class="bfa-admin-page-header">
    <div class="bfa-admin-page-header__copy"><p class="bfa-admin-page-header__eyebrow">Equipe da unidade</p><h1 class="bfa-admin-page-header__title">Novo professor</h1><p class="bfa-admin-page-header__description">Cadastre o professor, o vínculo com a unidade e sua remuneração inicial.</p></div>
</header>

<form class="bfa-admin-form bfa-professor-form" method="post" action="/unidade/@Model.UnidadeId/professores/novo">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="bfa-admin-notice bfa-admin-form-summary" role="alert"></div>
    @if (Model.CpfJaCadastradoNaRede)
    {
        <div class="bfa-admin-notice" role="status">
            <div><strong>Este professor já está cadastrado na rede.</strong><p>Utilize a opção de vínculo para associá-lo a esta unidade sem duplicar o cadastro.</p><a class="bfa-btn-secondary bfa-admin-button" href="/unidade/@Model.UnidadeId/professores/vincular?termo=@Uri.EscapeDataString(Model.Cpf ?? string.Empty)">Vincular professor existente</a></div>
        </div>
    }
    <div class="bfa-admin-form-sections">
      <section class="bfa-admin-card bfa-admin-form-card">
        <header class="bfa-professor-form__heading"><p>Dados cadastrais</p><h2>Professor</h2></header>
        <div class="bfa-professor-form-grid">
            <div class="bfa-form-field bfa-professor-form-wide"><label asp-for="NomeCompleto" class="bfa-form-label"></label><input asp-for="NomeCompleto" class="form-control bfa-form-control" autocomplete="name" /><span asp-validation-for="NomeCompleto" class="bfa-validation-message"></span></div>
            <div class="bfa-form-field"><label asp-for="Cpf" class="bfa-form-label"></label><input asp-for="Cpf" class="form-control bfa-form-control" inputmode="numeric" maxlength="14" data-bfa-mask="document" /><span asp-validation-for="Cpf" class="bfa-validation-message"></span></div>
            <div class="bfa-form-field"><label asp-for="Telefone" class="bfa-form-label"></label><input asp-for="Telefone" class="form-control bfa-form-control" inputmode="numeric" data-bfa-mask="phone" /><span asp-validation-for="Telefone" class="bfa-validation-message"></span></div>
            <div class="bfa-form-field bfa-professor-form-wide"><label asp-for="Email" class="bfa-form-label"></label><input asp-for="Email" class="form-control bfa-form-control" type="email" autocomplete="email" /><span asp-validation-for="Email" class="bfa-validation-message"></span></div>
            <div class="bfa-form-field bfa-professor-form-wide"><label class="bfa-form-label">Unidade</label><input class="form-control bfa-form-control" value="@Model.NomeUnidade" readonly /></div>
        </div>
      </section>
      <partial name="_RemuneracaoInicial" model="Model" />
    </div>
    <div class="bfa-admin-form-actions"><button class="bfa-btn-primary bfa-admin-button" type="submit">Cadastrar professor</button><a class="bfa-btn-secondary bfa-admin-button" href="/unidade/@Model.UnidadeId/professores">Cancelar</a></div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/bfa-input-masks.js" asp-append-version="true"></script>
    <script src="~/js/bfa-number-field.js" asp-append-version="true"></script>
    <script src="~/js/bfa-date-field.js" asp-append-version="true"></script>
}
