@model ProfessorUnidadeEditarViewModel
@{ ViewData["Title"] = "Editar professor"; Layout = "_UnidadeLayout"; }

<header class="bfa-admin-page-header">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Cadastro da rede</p>
        <h1 class="bfa-admin-page-header__title">Editar professor</h1>
        <p class="bfa-admin-page-header__description">Este cadastro pertence à rede e pode ser utilizado em outras unidades.</p>
    </div>
    <div class="bfa-admin-page-header__actions">
        <a class="bfa-btn-secondary bfa-admin-button" href="/unidade/@Model.UnidadeId/professores">Voltar</a>
    </div>
</header>

<form class="bfa-admin-form" method="post" action="/unidade/@Model.UnidadeId/professores/@Model.ProfessorId/editar">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="bfa-admin-notice bfa-admin-form-summary" role="alert"></div>

    <div class="bfa-admin-form-sections">
        <section class="bfa-form-card">
            <div class="bfa-card-title-row">
                <div class="bfa-card-icon">&#9823;</div>
                <h2>Dados cadastrais</h2>
            </div>
            <div class="bfa-fields">
                <div class="bfa-field">
                    <label asp-for="NomeCompleto" class="bfa-form-label"></label>
                    <input asp-for="NomeCompleto" class="form-control bfa-form-control" />
                    <span asp-validation-for="NomeCompleto" class="bfa-validation-message"></span>
                </div>
                <div class="bfa-field">
                    <label asp-for="Cpf" class="bfa-form-label"></label>
                    <input asp-for="Cpf" class="form-control bfa-form-control" inputmode="numeric" maxlength="14" data-bfa-mask="document" readonly style="opacity:0.7; cursor:not-allowed;" />
                    <span class="bfa-admin-form-help">CPF não pode ser alterado após o cadastro.</span>
                </div>
                <div class="bfa-field-grid-2">
                    <div class="bfa-field">
                        <label asp-for="Telefone" class="bfa-form-label"></label>
                        <input asp-for="Telefone" class="form-control bfa-form-control" inputmode="numeric" data-bfa-mask="phone" placeholder="(11) 91234-5678" />
                        <span asp-validation-for="Telefone" class="bfa-validation-message"></span>
                    </div>
                    <div class="bfa-field">
                        <label asp-for="Email" class="bfa-form-label"></label>
                        <input asp-for="Email" class="form-control bfa-form-control" type="email" autocomplete="email" placeholder="exemplo@bfa.com" />
                        <span asp-validation-for="Email" class="bfa-validation-message"></span>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="bfa-form-actions">
        <a class="bfa-btn-secondary bfa-admin-button" href="/unidade/@Model.UnidadeId/professores">Cancelar</a>
        <button class="bfa-btn-primary bfa-admin-button" type="submit">Salvar alterações</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/bfa-input-masks.js" asp-append-version="true"></script>
}
