@using BFA.Domain.Matriculas
@model MatriculasListaViewModel
@{
    ViewData["Title"] = "Matrículas";
    Layout = "_UnidadeLayout";
    var statusAtual = Model.Status?.ToString();
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-matriculas">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Operação da unidade</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-matriculas">Matrículas</h1>
        <p class="bfa-admin-page-header__description">
            Consulte as condições contratadas e a Grade dos alunos de @Model.NomeUnidade.
        </p>
    </div>
    <div class="bfa-admin-page-header__actions">
        @if (Model.PodeGerenciar)
        {
            <a class="bfa-btn-primary bfa-admin-button"
               asp-area="Unidade"
               asp-controller="Matriculas"
               asp-action="Nova"
               asp-route-unidadeId="@Model.UnidadeId">+ Nova matrícula</a>
        }
        else
        {
            <span class="bfa-admin-badge is-inactive">Somente leitura</span>
        }
    </div>
</header>

<form class="bfa-admin-card bfa-matricula-filters"
      action="/unidade/@Model.UnidadeId/matriculas"
      method="get"
      role="search">
    <div class="bfa-form-field">
        <label class="bfa-form-label" for="filtro-matricula-texto">Buscar por aluno</label>
        <input class="form-control bfa-form-control"
               id="filtro-matricula-texto"
               name="texto"
               type="search"
               value="@Model.Texto"
               maxlength="150"
               autocomplete="off"
               placeholder="Nome do aluno" />
    </div>
    <div class="bfa-form-field">
        <label class="bfa-form-label" for="filtro-matricula-status">Status</label>
        <select class="form-select bfa-form-control" id="filtro-matricula-status" name="status">
            <option value="" selected="@(!Model.Status.HasValue)">Todos</option>
            <option value="Ativa" selected="@(Model.Status == StatusMatricula.Ativa)">Ativa</option>
            <option value="Encerrada" selected="@(Model.Status == StatusMatricula.Encerrada)">Encerrada</option>
            <option value="Cancelada" selected="@(Model.Status == StatusMatricula.Cancelada)">Cancelada</option>
        </select>
    </div>
    <div class="bfa-matricula-filter-actions">
        <button class="bfa-btn-primary bfa-admin-button" type="submit">Filtrar</button>
        @if (Model.PossuiFiltros)
        {
            <a class="bfa-btn-secondary bfa-admin-button"
               href="/unidade/@Model.UnidadeId/matriculas">Limpar filtros</a>
        }
    </div>
</form>

@if (Model.Matriculas.Count == 0)
{
    <section class="bfa-admin-empty-state bfa-unidade-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            <h2>@(Model.PossuiFiltros
                    ? "Nenhuma matrícula corresponde aos filtros informados."
                    : "Nenhuma matrícula encontrada.")</h2>
            <p>@(Model.PossuiFiltros
                    ? "Ajuste a busca ou o status para consultar outros resultados."
                    : "As matrículas desta unidade aparecerão aqui quando forem cadastradas.")</p>
        </div>
    </section>
}
else
{
    <div class="bfa-admin-table-container bfa-admin-desktop-list bfa-matricula-lista">
        <table class="bfa-admin-table bfa-matricula-table">
            <thead>
                <tr>
                    <th>Aluno e plano</th>
                    <th>Status</th>
                    <th>Período</th>
                    <th>Condições</th>
                    <th>Grade atual</th>
                    <th>Ação</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Matriculas)
            {
                <tr>
                    <td>
                        <span class="bfa-matricula-primary">
                            <strong>@item.NomeAluno</strong>
                            <small>@item.Plano</small>
                        </span>
                    </td>
                    <td><span class="bfa-admin-badge @(item.Ativa ? "is-active" : "is-inactive")">@item.Status</span></td>
                    <td>
                        <span class="bfa-matricula-primary">
                            <strong>@item.DataInicio</strong>
                            <small>Fim previsto · @item.DataFimPrevista</small>
                        </span>
                    </td>
                    <td>
                        <span class="bfa-matricula-primary">
                            <strong>@item.ValorMensalContratado</strong>
                            <small>@item.FrequenciaSemanal</small>
                        </span>
                    </td>
                    <td>@item.GradeAtual</td>
                    <td>
                        <a class="bfa-btn-secondary bfa-admin-button"
                           asp-area="Unidade"
                           asp-controller="Matriculas"
                           asp-action="Detalhes"
                           asp-route-unidadeId="@Model.UnidadeId"
                           asp-route-matriculaId="@item.MatriculaId"
                           asp-route-texto="@Model.Texto"
                           asp-route-status="@statusAtual">Ver detalhes</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <section class="bfa-admin-mobile-list" aria-label="Matrículas da unidade">
        @foreach (var item in Model.Matriculas)
        {
            <article class="bfa-admin-card bfa-matricula-card">
                <header>
                    <div>
                        <p>Aluno</p>
                        <h2>@item.NomeAluno</h2>
                        <span>@item.Plano</span>
                    </div>
                    <span class="bfa-admin-badge @(item.Ativa ? "is-active" : "is-inactive")">@item.Status</span>
                </header>
                <dl>
                    <div><dt>Início</dt><dd>@item.DataInicio</dd></div>
                    <div><dt>Fim previsto</dt><dd>@item.DataFimPrevista</dd></div>
                    <div><dt>Mensalidade</dt><dd>@item.ValorMensalContratado</dd></div>
                    <div><dt>Frequência</dt><dd>@item.FrequenciaSemanal</dd></div>
                    <div><dt>Grade atual</dt><dd>@item.GradeAtual</dd></div>
                </dl>
                <footer>
                    <a class="bfa-btn-secondary bfa-admin-button"
                       asp-area="Unidade"
                       asp-controller="Matriculas"
                       asp-action="Detalhes"
                       asp-route-unidadeId="@Model.UnidadeId"
                       asp-route-matriculaId="@item.MatriculaId"
                       asp-route-texto="@Model.Texto"
                       asp-route-status="@statusAtual">Ver detalhes</a>
                </footer>
            </article>
        }
    </section>
}
