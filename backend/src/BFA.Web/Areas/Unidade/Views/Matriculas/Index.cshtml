@using BFA.Domain.Matriculas
@using BFA.Web.ViewModels.Shared
@model MatriculasListaViewModel
@{
    ViewData["Title"] = "Matrículas";
    Layout = "_UnidadeLayout";
    var statusAtual = Model.Status?.ToString();
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-matriculas">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Operação da unidade</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-matriculas">Matrículas</h1>
        <p class="bfa-admin-page-header__description">
            Consulte as condições contratadas e a Grade dos alunos de @Model.NomeUnidade.
        </p>
    </div>
    <div class="bfa-admin-page-header__actions">
        @if (Model.PodeGerenciar)
        {
            <a class="bfa-btn-primary bfa-admin-button"
               asp-area="Unidade"
               asp-controller="Matriculas"
               asp-action="Nova"
               asp-route-unidadeId="@Model.UnidadeId">+ Nova matrícula</a>
        }
        else
        {
            <span class="bfa-admin-badge is-inactive">Somente leitura</span>
        }
    </div>
</header>

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="bfa-admin-notice" role="status"><strong>@sucesso</strong></div>
}

<section class="bfa-list-toolbar" aria-label="Busca e filtros">
    <form class="bfa-list-search" method="get" action="/unidade/@Model.UnidadeId/matriculas">
        <input type="hidden" name="status" value="@statusAtual" />
        <svg class="bfa-list-search__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
        <input type="search" name="texto" value="@Model.Texto" placeholder="Buscar por nome do aluno..." aria-label="Buscar matrícula" />
    </form>
    <nav class="bfa-filter-tabs" aria-label="Filtrar matrículas por status">
        @{
            var baseSemStatus = $"/unidade/{Model.UnidadeId}/matriculas";
        var qsTexto = string.IsNullOrWhiteSpace(Model.Texto) ? "" : $"&texto={Uri.EscapeDataString(Model.Texto)}";
    }
    <a class="bfa-filter-tab @(!Model.Status.HasValue ? "is-active" : null)" href="@baseSemStatus@(Model.Texto is not null ? $"?texto={Uri.EscapeDataString(Model.Texto)}" : "")">
        Todas <span class="bfa-filter-count">@Model.TotalItens</span>
    </a>
    <a class="bfa-filter-tab @(Model.Status == StatusMatricula.Ativa ? "is-active" : null)" href="@baseSemStatus?status=Ativa@(string.IsNullOrWhiteSpace(Model.Texto) ? "" : $"&texto={Uri.EscapeDataString(Model.Texto)}")">
        Ativas <span class="bfa-filter-count">@Model.TotalAtivas</span>
    </a>
    <a class="bfa-filter-tab @(Model.Status == StatusMatricula.Encerrada ? "is-active" : null)" href="@baseSemStatus?status=Encerrada@(string.IsNullOrWhiteSpace(Model.Texto) ? "" : $"&texto={Uri.EscapeDataString(Model.Texto)}")">
        Encerradas <span class="bfa-filter-count">@Model.TotalEncerradas</span>
    </a>
    <a class="bfa-filter-tab @(Model.Status == StatusMatricula.Cancelada ? "is-active" : null)" href="@baseSemStatus?status=Cancelada@(string.IsNullOrWhiteSpace(Model.Texto) ? "" : $"&texto={Uri.EscapeDataString(Model.Texto)}")">
        Canceladas <span class="bfa-filter-count">@Model.TotalCanceladas</span>
    </a>
    </nav>
</section>

@if (Model.Matriculas.Count == 0)
{
    <section class="bfa-admin-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            <h2>@(Model.PossuiFiltros
                    ? "Nenhuma matrícula corresponde aos filtros informados."
                    : "Nenhuma matrícula encontrada.")</h2>
            <p>@(Model.PossuiFiltros
                    ? "Ajuste a busca ou o status para consultar outros resultados."
                    : "As matrículas desta unidade aparecerão aqui quando forem cadastradas.")</p>
        </div>
    </section>
}
else
{
    <div class="bfa-data-card bfa-admin-desktop-list">
        <div class="bfa-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Aluno e plano</th>
                        <th>Status</th>
                        <th>Período</th>
                        <th>Condições</th>
                        <th>Grade atual</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Matriculas)
                {
                    <tr>
                        <td>
                            <div class="bfa-data-primary">@item.NomeAluno</div>
                            <div class="bfa-data-secondary">@item.Plano</div>
                        </td>
                        <td>
                            <span class="bfa-data-badge @(item.Ativa ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                                <i class="bfa-data-badge__dot"></i>
                                @item.Status
                            </span>
                        </td>
                        <td>
                            <div class="bfa-data-primary">@item.DataInicio</div>
                            <div class="bfa-data-secondary">Fim previsto · @item.DataFimPrevista</div>
                        </td>
                        <td>
                            <div class="bfa-data-primary">@item.ValorMensalContratado</div>
                            <div class="bfa-data-secondary">@item.FrequenciaSemanal</div>
                        </td>
                        <td>@item.GradeAtual</td>
                        <td>
                            <div class="bfa-actions-cell">
                                <a class="bfa-admin-button bfa-btn-secondary"
                                   asp-area="Unidade"
                                   asp-controller="Matriculas"
                                   asp-action="Detalhes"
                                   asp-route-unidadeId="@Model.UnidadeId"
                                   asp-route-matriculaId="@item.MatriculaId"
                                   asp-route-texto="@Model.Texto"
                                   asp-route-status="@statusAtual">Detalhes</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="bfa-table-footer">
            @{
                var primeiroIndice = Model.TotalItens == 0 ? 0 : (Model.PaginaAtual - 1) * Model.TamanhoPagina + 1;
                var ultimoIndice = Math.Min(Model.PaginaAtual * Model.TamanhoPagina, Model.TotalItens);
            }
            <div>Mostrando <strong>@primeiroIndice–@ultimoIndice</strong> de <strong>@Model.TotalItens</strong> matrículas</div>
            @{
                var qsParts = new List<string>();
                if (Model.Status.HasValue)
                    qsParts.Add($"status={Model.Status.Value}");
                if (!string.IsNullOrWhiteSpace(Model.Texto))
                    qsParts.Add($"texto={Uri.EscapeDataString(Model.Texto)}");
                var baseQs = string.Join("&", qsParts);

                var totalPaginas = (int)Math.Ceiling((double)Model.TotalItens / Model.TamanhoPagina);
                var paginacao = new PaginacaoViewModel
                {
                    PaginaAtual = Model.PaginaAtual,
                    TotalPaginas = totalPaginas,
                    TotalItens = Model.TotalItens,
                    PrimeiroIndice = primeiroIndice,
                    UltimoIndice = ultimoIndice,
                    BaseQueryString = baseQs
                };
            }
            <partial name="_Paginacao" model="paginacao" />
        </div>
    </div>

    <section class="bfa-mobile-card-list" aria-label="Matrículas da unidade">
        @foreach (var item in Model.Matriculas)
        {
            <article class="bfa-mobile-card">
                <div class="bfa-mobile-card__head">
                    <div>
                        <div class="bfa-data-primary">@item.NomeAluno</div>
                        <div class="bfa-data-secondary">@item.Plano</div>
                    </div>
                    <span class="bfa-data-badge @(item.Ativa ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                        <i class="bfa-data-badge__dot"></i>
                        @item.Status
                    </span>
                </div>
                <div class="bfa-mobile-card__grid">
                    <div>
                        <span class="bfa-mobile-card__label">Período</span>
                        <div>@item.DataInicio</div>
                        <div class="bfa-data-secondary">Fim previsto · @item.DataFimPrevista</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Condições</span>
                        <div>@item.ValorMensalContratado</div>
                        <div class="bfa-data-secondary">@item.FrequenciaSemanal</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Grade atual</span>
                        <div>@item.GradeAtual</div>
                    </div>
                </div>
                <div class="bfa-mobile-card__actions">
                    <a class="bfa-admin-button bfa-btn-secondary"
                       asp-area="Unidade"
                       asp-controller="Matriculas"
                       asp-action="Detalhes"
                       asp-route-unidadeId="@Model.UnidadeId"
                       asp-route-matriculaId="@item.MatriculaId"
                       asp-route-texto="@Model.Texto"
                       asp-route-status="@statusAtual">Detalhes</a>
                </div>
            </article>
        }
    </section>
}
