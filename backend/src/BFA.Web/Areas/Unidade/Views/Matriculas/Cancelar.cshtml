@model FinalizarMatriculaViewModel
@{
    ViewData["Title"] = "Cancelar matrícula";
    Layout = "_UnidadeLayout";
    var dataMinima = Model.DataMinimaEncerramento;
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-cancelar-matricula">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Matrícula · @Model.NomeAluno</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-cancelar-matricula">Cancelar matrícula</h1>
        <p class="bfa-admin-page-header__description">O cancelamento encerra antecipadamente esta contratação.</p>
    </div>
</header>

<form class="bfa-admin-form bfa-admin-form-sections"
      method="post"
      asp-area="Unidade"
      asp-controller="Matriculas"
      asp-action="Cancelar"
      asp-route-unidadeId="@Model.UnidadeId"
      asp-route-matriculaId="@Model.MatriculaId"
      data-bfa-matricula-finalizar>
    @Html.AntiForgeryToken()
    <section class="bfa-admin-card bfa-admin-form-card" aria-labelledby="titulo-confirmar-cancelamento">
        <div asp-validation-summary="ModelOnly" class="bfa-validation-summary" role="alert"></div>
        <h2 id="titulo-confirmar-cancelamento">Confirmar cancelamento antecipado</h2>
        <p class="bfa-matricula-muted">Esta ação é excepcional. A matrícula e a Grade atual serão encerradas na data informada, sem excluir o histórico.</p>
        <div class="bfa-form-field">
            <label asp-for="DataFinalTexto" class="bfa-form-label">Data final efetiva</label>
            <input asp-for="DataFinalTexto" class="form-control bfa-form-control" type="text" inputmode="numeric" placeholder="dd/MM/aaaa" maxlength="10" data-min-date="@dataMinima" />
            <span asp-validation-for="DataFinalTexto" class="bfa-validation-message"></span>
            <p class="bfa-matricula-muted">A data mínima é @dataMinima.</p>
        </div>
        <div class="bfa-admin-form-actions">
            <a class="bfa-btn-secondary bfa-admin-button" asp-action="Detalhes" asp-route-unidadeId="@Model.UnidadeId" asp-route-matriculaId="@Model.MatriculaId">Voltar</a>
            <button class="bfa-btn-secondary bfa-admin-button bfa-matricula-terminal-action" type="submit">Confirmar cancelamento</button>
        </div>
    </section>
</form>
