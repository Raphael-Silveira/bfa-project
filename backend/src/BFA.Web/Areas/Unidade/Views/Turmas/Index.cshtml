@using BFA.Web.ViewModels.Shared
@model TurmasUnidadeIndexViewModel
@{
    ViewData["Title"] = "Turmas";
    Layout = "_UnidadeLayout";
    var governanca = ViewData[GovernancaOperacionalUnidadeViewData.Chave]
        as GovernancaOperacionalUnidadeViewModel;
    var podeGerenciar = governanca?.PodeGerenciarTurmas ?? true;
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-turmas">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Operação da unidade</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-turmas">Turmas</h1>
        <p class="bfa-admin-page-header__description">Turmas e horários recorrentes de @Model.NomeUnidade.</p>
    </div>
    <div class="bfa-admin-page-header__actions">
        @if (podeGerenciar)
        {
            <a class="bfa-btn-primary bfa-admin-button" href="/unidade/@Model.UnidadeId/turmas/nova">Nova turma</a>
        }
    </div>
</header>

<section class="bfa-turmas-hero">
    <div class="bfa-turmas-hero__copy">
        <p class="bfa-turmas-hero__eyebrow">Organização de aulas</p>
        <h2 class="bfa-turmas-hero__title">Turmas em operação</h2>
        <p class="bfa-turmas-hero__description">Revise horários recorrentes, professor responsável e capacidade sem sair da listagem.</p>
    </div>

    <div class="bfa-turmas-hero__stats">
        <div class="bfa-admin-card bfa-turmas-stat">
            <span class="bfa-turmas-stat__label">Total</span>
            <strong class="bfa-turmas-stat__value">@Model.TotalItens</strong>
        </div>
        <div class="bfa-admin-card bfa-turmas-stat">
            <span class="bfa-turmas-stat__label">Gerenciamento</span>
            <strong class="bfa-turmas-stat__value">@(podeGerenciar ? "Liberado" : "Somente leitura")</strong>
        </div>
    </div>
</section>

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="bfa-admin-notice" role="status"><strong>@sucesso</strong></div>
}

@if (Model.Turmas.Count == 0)
{
    <section class="bfa-admin-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            <h2>Nenhuma turma cadastrada nesta unidade.</h2>
            <p>@(podeGerenciar ? "Use \u201cNova turma\u201d para cadastrar a primeira turma e seus hor\u00E1rios recorrentes." : "A opera\u00E7\u00E3o da unidade ainda n\u00E3o possui turmas cadastradas.")</p>
        </div>
    </section>
}
else
{
    <div class="bfa-data-card bfa-admin-desktop-list bfa-turmas-list-card">
        <div class="bfa-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Turma</th>
                        <th>Professor</th>
                        <th>Capacidade</th>
                        <th>Horários vigentes</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var turma in Model.Turmas)
                {
                    <tr>
                        <td>
                            <div class="bfa-data-primary">@turma.Nome</div>
                        </td>
                        <td>@turma.NomeProfessor</td>
                        <td>@turma.Capacidade @(turma.Capacidade == 1 ? "aluno" : "alunos")</td>
                        <td><partial name="_HorariosResumo" model="turma.Horarios" /></td>
                        <td>
                            <span class="bfa-data-badge @(turma.Ativo ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                                <i class="bfa-data-badge__dot"></i>
                                @(turma.Ativo ? "Ativa" : "Inativa")
                            </span>
                        </td>
                        <td>
                            <div class="bfa-actions-cell bfa-actions-cell--spaced">
                                @if (podeGerenciar)
                                {
                                    <a class="bfa-admin-button bfa-btn-secondary" href="/unidade/@Model.UnidadeId/turmas/@turma.Id/editar">Editar</a>
                                    <a class="bfa-admin-button bfa-btn-secondary" href="/unidade/@Model.UnidadeId/turmas/@turma.Id/horarios">Horários</a>
                                    <a class="bfa-admin-button bfa-btn-secondary" href="/unidade/@Model.UnidadeId/turmas/@turma.Id/professor">Professor</a>
                                }
                                else
                                {
                                    <span class="bfa-data-secondary">Somente leitura</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="bfa-table-footer bfa-turmas-list-card__footer">
            @{
                var primeiroIndice = Model.TotalItens == 0 ? 0 : (Model.PaginaAtual - 1) * Model.TamanhoPagina + 1;
                var ultimoIndice = Math.Min(Model.PaginaAtual * Model.TamanhoPagina, Model.TotalItens);
            }
            <div>Mostrando <strong>@primeiroIndice–@ultimoIndice</strong> de <strong>@Model.TotalItens</strong> turmas</div>
            @{
                var totalPaginas = (int)Math.Ceiling((double)Model.TotalItens / Model.TamanhoPagina);
                var paginacao = new PaginacaoViewModel
                {
                    PaginaAtual = Model.PaginaAtual,
                    TotalPaginas = totalPaginas,
                    TotalItens = Model.TotalItens,
                    PrimeiroIndice = primeiroIndice,
                    UltimoIndice = ultimoIndice,
                    BaseQueryString = string.Empty
                };
            }
            <partial name="_Paginacao" model="paginacao" />
        </div>
    </div>

    <section class="bfa-mobile-card-list" aria-label="Turmas da unidade">
        @foreach (var turma in Model.Turmas)
        {
            <article class="bfa-mobile-card">
                <div class="bfa-mobile-card__head">
                    <div>
                        <div class="bfa-data-primary">@turma.Nome</div>
                        <div class="bfa-data-secondary">@turma.NomeProfessor</div>
                    </div>
                    <span class="bfa-data-badge @(turma.Ativo ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                        <i class="bfa-data-badge__dot"></i>
                        @(turma.Ativo ? "Ativa" : "Inativa")
                    </span>
                </div>
                <div class="bfa-mobile-card__grid">
                    <div>
                        <span class="bfa-mobile-card__label">Capacidade</span>
                        <div>@turma.Capacidade @(turma.Capacidade == 1 ? "aluno" : "alunos")</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Horários vigentes</span>
                        <div><partial name="_HorariosResumo" model="turma.Horarios" /></div>
                    </div>
                </div>
                @if (podeGerenciar)
                {
                    <div class="bfa-mobile-card__actions">
                        <a class="bfa-admin-button bfa-btn-secondary" href="/unidade/@Model.UnidadeId/turmas/@turma.Id/editar">Editar</a>
                        <a class="bfa-admin-button bfa-btn-secondary" href="/unidade/@Model.UnidadeId/turmas/@turma.Id/horarios">Horários</a>
                        <a class="bfa-admin-button bfa-btn-secondary" href="/unidade/@Model.UnidadeId/turmas/@turma.Id/professor">Professor</a>
                    </div>
                }
            </article>
        }
    </section>
}

@section Styles {
<style>
    .bfa-turmas-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
        gap: 1rem;
        padding: 1.25rem;
        border: 1px solid var(--bfa-border);
        border-radius: var(--radius-lg);
        background:
            radial-gradient(circle at top left, rgba(0, 173, 181, 0.11), transparent 18rem),
            linear-gradient(145deg, rgba(29, 32, 35, 0.98), rgba(21, 23, 25, 0.98));
        box-shadow: 0 1rem 2.75rem rgba(0, 0, 0, 0.22);
    }

    .bfa-turmas-hero__eyebrow {
        margin: 0 0 0.35rem;
        color: var(--bfa-accent);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .bfa-turmas-hero__title {
        margin: 0;
        color: var(--bfa-white);
        font-size: clamp(1.45rem, 3vw, 2rem);
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .bfa-turmas-hero__description {
        max-width: 42rem;
        margin: 0.65rem 0 0;
        color: var(--bfa-text-secondary);
    }

    .bfa-turmas-hero__stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem;
    }

    .bfa-turmas-stat {
        display: grid;
        gap: 0.35rem;
        align-content: start;
    }

    .bfa-turmas-stat__label {
        color: var(--bfa-text-secondary);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .bfa-turmas-stat__value {
        color: var(--bfa-white);
        font-size: clamp(1.3rem, 3vw, 1.75rem);
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .bfa-turmas-list-card {
        overflow: hidden;
    }

    @@media (max-width: 64rem) {
        .bfa-turmas-hero {
            grid-template-columns: 1fr;
        }
    }
</style>
}
