@model TurmaEditarViewModel
@{ ViewData["Title"] = "Editar turma"; Layout = "_UnidadeLayout"; }

<header class="bfa-admin-page-header">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Operação da unidade</p>
        <h1 class="bfa-admin-page-header__title">Editar turma</h1>
        <p class="bfa-admin-page-header__description">Altere somente nome e capacidade. Professor e horários permanecem históricos.</p>
    </div>
    <div class="bfa-admin-page-header__actions">
        <a class="bfa-btn-secondary bfa-admin-button" href="/unidade/@Model.UnidadeId/turmas">Voltar</a>
    </div>
</header>

<form class="bfa-admin-form" method="post" action="/unidade/@Model.UnidadeId/turmas/@Model.TurmaId/editar">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="bfa-admin-notice bfa-admin-form-summary" role="alert"></div>

    <div class="bfa-admin-form-sections">
        <section class="bfa-form-card">
            <div class="bfa-card-title-row">
                <div class="bfa-card-icon">&#127917;</div>
                <h2>Dados da turma</h2>
            </div>
            <div class="bfa-fields">
                <div class="bfa-field">
                    <label asp-for="Nome" class="bfa-form-label"></label>
                    <input asp-for="Nome" class="form-control bfa-form-control" maxlength="150" />
                    <span asp-validation-for="Nome" class="bfa-validation-message"></span>
                </div>
                <div class="bfa-field">
                    <label asp-for="Capacidade" class="bfa-form-label"></label>
                    <input asp-for="Capacidade" class="form-control bfa-form-control" type="number" min="1" inputmode="numeric" />
                    <span asp-validation-for="Capacidade" class="bfa-validation-message"></span>
                </div>
            </div>
        </section>

        <section class="bfa-form-card">
            <div class="bfa-card-title-row">
                <div class="bfa-card-icon">&#128100;</div>
                <h2>Professor e horários</h2>
            </div>
            <dl class="bfa-fields" style="margin: 0;">
                <div class="bfa-field">
                    <dt class="bfa-form-label">Professor responsável</dt>
                    <dd style="margin: 0; padding: 0.625rem 0; color: var(--bfa-text-primary);">@Model.NomeProfessor</dd>
                </div>
                <div class="bfa-field">
                    <dt class="bfa-form-label">Horários vigentes</dt>
                    <dd style="margin: 0; padding: 0.625rem 0; color: var(--bfa-text-primary);">
                        <partial name="_HorariosResumo" model="Model.Horarios" />
                    </dd>
                </div>
            </dl>
        </section>
    </div>

    <div class="bfa-form-actions">
        <a class="bfa-btn-secondary bfa-admin-button" href="/unidade/@Model.UnidadeId/turmas">Cancelar</a>
        <button class="bfa-btn-primary bfa-admin-button" type="submit">Salvar alterações</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
