@model CobrancaDetalheAlunoViewModel
@{
    ViewData["Title"] = $"Detalhes do aluno - {Model.AlunoNome}";
    Layout = "_UnidadeLayout";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-detalhes-aluno">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">Financeiro / @Model.NomeUnidade</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-detalhes-aluno">Cobranças de @Model.AlunoNome</h1>
        <p class="bfa-admin-page-header__description">
            Todas as cobranças vinculadas a este aluno.
        </p>
    </div>
    <div class="bfa-admin-page-header__actions">
        <a class="bfa-btn-secondary bfa-admin-button"
           asp-area="Unidade"
           asp-controller="Cobrancas"
           asp-action="Index"
           asp-route-unidadeId="@Model.UnidadeId">Voltar à listagem</a>
        @if (Model.PodeGerenciar)
        {
            <a class="bfa-btn-primary bfa-admin-button"
               asp-area="Unidade"
               asp-controller="Cobrancas"
               asp-action="Nova"
               asp-route-unidadeId="@Model.UnidadeId"
               asp-route-alunoId="@Model.AlunoId">Nova cobrança</a>
        }
    </div>
</header>

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="bfa-admin-notice" role="status"><strong>@sucesso</strong></div>
}

<section class="bfa-aula-detail-card" aria-labelledby="resumo-aluno">
    <header class="bfa-aula-detail-card__header">
        <h2 id="resumo-aluno">Resumo financeiro</h2>
    </header>
    <div class="bfa-aula-detail-grid">
        <div class="bfa-aula-detail-item">
            <div class="bfa-aula-detail-item__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z"></path><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <span class="bfa-aula-detail-item__label">Total a Receber</span>
            <div class="bfa-aula-detail-item__value">@Model.ValorTotal</div>
        </div>
        <div class="bfa-aula-detail-item">
            <div class="bfa-aula-detail-item__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z"></path><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <span class="bfa-aula-detail-item__label">Total Pago</span>
            <div class="bfa-aula-detail-item__value bfa-text-success">@Model.ValorPagoTotal</div>
        </div>
        <div class="bfa-aula-detail-item">
            <div class="bfa-aula-detail-item__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z"></path><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <span class="bfa-aula-detail-item__label">Saldo Devedor</span>
            <div class="bfa-aula-detail-item__value bfa-text-warning">@Model.SaldoDevedorTotal</div>
        </div>
        <div class="bfa-aula-detail-item">
            <div class="bfa-aula-detail-item__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </div>
            <span class="bfa-aula-detail-item__label">Qtd. Cobranças</span>
            <div class="bfa-aula-detail-item__value">@Model.Cobrancas.Count</div>
        </div>
        <div class="bfa-aula-detail-item">
            <div class="bfa-aula-detail-item__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <span class="bfa-aula-detail-item__label">Próximo Vencimento</span>
            <div class="bfa-aula-detail-item__value">
                @(Model.Cobrancas.Where(c => c.Status is "Pendente" or "Atrasada").OrderBy(c => c.DataVencimento).FirstOrDefault()?.DataVencimento ?? "—")
            </div>
        </div>
        <div class="bfa-aula-detail-item">
            <div class="bfa-aula-detail-item__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            </div>
            <span class="bfa-aula-detail-item__label">Cobranças Atrasadas</span>
            <div class="bfa-aula-detail-item__value bfa-text-warning">
                @Model.Cobrancas.Count(c => c.Status == "Atrasada")
            </div>
        </div>
    </div>
</section>

@if (Model.Cobrancas.Count == 0)
{
    <section class="bfa-admin-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            <h2>Nenhuma cobrança encontrada para este aluno.</h2>
        </div>
    </section>
}
else
{
    <div class="bfa-data-card bfa-admin-desktop-list">
        <div class="bfa-table-wrap">
            <table class="bfa-cobranca-table">
                <thead>
                    <tr>
                        <th>Descrição</th>
                        <th>Tipo</th>
                        <th>Valor</th>
                        <th>Pago</th>
                        <th>Saldo</th>
                        <th>Vencimento</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Cobrancas)
                {
                    var badgeClass = item.Status switch
                    {
                        "Pendente" => "bfa-data-badge--pending",
                        "Paga" => "bfa-data-badge--active",
                        "Atrasada" => "bfa-data-badge--overdue",
                        "Cancelada" => "bfa-data-badge--inactive",
                        _ => ""
                    };
                    <tr class="bfa-cobranca-grupo">
                        <td>
                            <div class="bfa-data-primary">@item.Descricao</div>
                        </td>
                        <td>
                            <span class="bfa-data-badge @badgeClass bfa-data-badge--inline">
                                <i class="bfa-data-badge__dot"></i>
                                @item.Tipo
                            </span>
                        </td>
                        <td>
                            <div class="bfa-data-primary">@item.Valor</div>
                        </td>
                        <td>
                            <div class="bfa-data-secondary">@item.ValorPago</div>
                        </td>
                        <td>
                            <div class="bfa-data-primary">@item.SaldoDevedor</div>
                        </td>
                        <td>
                            <div class="bfa-data-primary">@item.DataVencimento</div>
                        </td>
                        <td>
                            <span class="bfa-data-badge @badgeClass">
                                <i class="bfa-data-badge__dot"></i>
                                @item.Status
                            </span>
                        </td>
                        <td>
                            <div class="bfa-actions-cell">
                                @if (item.PodeRegistrarPagamento)
                                {
                                    <a class="bfa-admin-button bfa-btn-secondary bfa-btn-sm"
                                       asp-area="Unidade"
                                       asp-controller="Cobrancas"
                                       asp-action="RegistrarPagamento"
                                       asp-route-unidadeId="@Model.UnidadeId"
                                       asp-route-cobrancaId="@item.CobrancaId">Registrar pagamento</a>
                                }
                                @if (item.PodeCancelar)
                                {
                                    <form asp-area="Unidade"
                                          asp-controller="Cobrancas"
                                          asp-action="Cancelar"
                                          asp-route-unidadeId="@Model.UnidadeId"
                                          asp-route-cobrancaId="@item.CobrancaId"
                                          method="post"
                                          style="display:inline;">
                                        <button class="bfa-admin-button bfa-btn-secondary bfa-btn-sm"
                                                type="submit"
                                                onclick="return confirm('Tem certeza que deseja cancelar esta cobrança?')">Cancelar</button>
                                    </form>
                                }
                                <a class="bfa-admin-button bfa-btn-secondary bfa-btn-sm"
                                   asp-area="Unidade"
                                   asp-controller="Cobrancas"
                                   asp-action="Detalhes"
                                   asp-route-unidadeId="@Model.UnidadeId"
                                   asp-route-cobrancaId="@item.CobrancaId">Detalhes</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <section class="bfa-mobile-card-list" aria-label="Cobranças do aluno">
        @foreach (var item in Model.Cobrancas)
        {
            var badgeClass = item.Status switch
            {
                "Pendente" => "bfa-data-badge--pending",
                "Paga" => "bfa-data-badge--active",
                "Atrasada" => "bfa-data-badge--overdue",
                "Cancelada" => "bfa-data-badge--inactive",
                _ => ""
            };
            <article class="bfa-mobile-card">
                <div class="bfa-mobile-card__head">
                    <div>
                        <div class="bfa-data-primary">@item.Descricao</div>
                        <div class="bfa-data-secondary">@item.Tipo</div>
                    </div>
                    <span class="bfa-data-badge @badgeClass">
                        <i class="bfa-data-badge__dot"></i>
                        @item.Status
                    </span>
                </div>
                <div class="bfa-mobile-card__grid">
                    <div>
                        <span class="bfa-mobile-card__label">Valor</span>
                        <div>@item.Valor</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Pago</span>
                        <div>@item.ValorPago</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Saldo</span>
                        <div>@item.SaldoDevedor</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Vencimento</span>
                        <div>@item.DataVencimento</div>
                    </div>
                </div>
                <div class="bfa-mobile-card__actions">
                    @if (item.PodeRegistrarPagamento)
                    {
                        <a class="bfa-admin-button bfa-btn-secondary"
                           asp-area="Unidade"
                           asp-controller="Cobrancas"
                           asp-action="RegistrarPagamento"
                           asp-route-unidadeId="@Model.UnidadeId"
                           asp-route-cobrancaId="@item.CobrancaId">Registrar pagamento</a>
                    }
                    @if (item.PodeCancelar)
                    {
                        <form asp-area="Unidade"
                              asp-controller="Cobrancas"
                              asp-action="Cancelar"
                              asp-route-unidadeId="@Model.UnidadeId"
                              asp-route-cobrancaId="@item.CobrancaId"
                              method="post"
                              style="display:inline;">
                            <button class="bfa-admin-button bfa-btn-secondary"
                                    type="submit"
                                    onclick="return confirm('Tem certeza que deseja cancelar esta cobrança?')">Cancelar</button>
                        </form>
                    }
                    <a class="bfa-admin-button bfa-btn-secondary"
                       asp-area="Unidade"
                       asp-controller="Cobrancas"
                       asp-action="Detalhes"
                       asp-route-unidadeId="@Model.UnidadeId"
                       asp-route-cobrancaId="@item.CobrancaId">Detalhes</a>
                </div>
            </article>
        }
    </section>
}