    }

    .bfa-cobranca-subgrid-row__info {
        display: flex; flex-direction: column; gap: 0.125rem; min-width: 0;
    }

    .bfa-cobranca-subgrid-row__descricao {
        font-size: 0.8125rem; font-weight: 500; color: var(--bfa-white);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    .bfa-cobranca-subgrid-row__sub {
        font-size: 0.6875rem; color: var(--bfa-gray);
    }

    .bfa-cobranca-subgrid-row__valor {
        font-size: 0.875rem; font-weight: 600; color: var(--bfa-white);
        text-align: right;
    }

    .bfa-cobranca-subgrid-row__pago {
        font-size: 0.6875rem; color: #4ade80; text-align: right;
    }

    .bfa-cobranca-subgrid-row__vencimento {
        font-size: 0.8125rem; color: var(--bfa-white); text-align: right;
    }

    .bfa-cobranca-subgrid-row__acoes {
        text-align: right; padding-left: 0.75rem;
    }

    @@media (max-width: 768px) {
        .bfa-cobranca-subgrid-header { display: none; }
        .bfa-cobranca-subgrid-row {
            grid-template-columns: auto 1fr;
            gap: 0.375rem 0.625rem;
            padding: 0.625rem 0.75rem;
        }
        .bfa-cobranca-subgrid-row__tipo { grid-column: 1 / -1; }
        .bfa-cobranca-subgrid-row__valor { text-align: left; grid-column: 1 / -1; }
