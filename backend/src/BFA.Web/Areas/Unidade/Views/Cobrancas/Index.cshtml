    }

    .bfa-cobranca-modal__table .bfa-admin-table {
        min-width: 0;
    }

    .bfa-cobranca-modal__form {
        display: grid;
        gap: 1rem;
    }

    .bfa-cobranca-modal__form .bfa-form-field {
        margin-bottom: 0;
    }

    .bfa-cobranca-modal__footer {
        gap: 0.75rem;
        padding: 1rem 1.5rem 1.25rem;
        border-top: 1px solid rgba(255, 255, 255, 0.07);
