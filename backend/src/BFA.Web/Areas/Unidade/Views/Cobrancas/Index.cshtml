    @@media (max-width: 30rem) {
        .bfa-cobranca-modal .modal-dialog {
            width: calc(100vw - 1.5rem);
        }

        .bfa-cobranca-modal__header,
        .bfa-cobranca-modal__body,
        .bfa-cobranca-modal__footer {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        .bfa-cobranca-modal__footer {
