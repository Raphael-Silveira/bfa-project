@using System.Globalization
@using BFA.Application.Planos
@using BFA.Web.ViewModels.Shared
@model BFA.Web.ViewModels.Planos.PlanosListaViewModel
@{
    var cultura = CultureInfo.GetCultureInfo("pt-BR");
    var titulo = Model.EhLocal ? "Planos da Unidade" : "Planos da Rede";
    var descricao = Model.EhLocal
        ? $"Catálogo comercial exclusivo de {Model.NomeUnidade}."
        : "Catálogo comercial administrado pela Franqueadora.";
}

<header class="bfa-admin-page-header" aria-labelledby="titulo-planos">
    <div class="bfa-admin-page-header__copy">
        <p class="bfa-admin-page-header__eyebrow">@(Model.EhLocal ? "Operação da unidade" : "Rede BFA")</p>
        <h1 class="bfa-admin-page-header__title" id="titulo-planos">@titulo</h1>
        <p class="bfa-admin-page-header__description">@descricao</p>
    </div>
    @if (Model.PodeGerenciar)
    {
        <div class="bfa-admin-page-header__actions">
            <a class="bfa-btn-primary bfa-admin-button" href="@Model.RotaBase/novo">Novo plano</a>
        </div>
    }
</header>

@if (Model.EhLocal && Model.PossuiFranqueadoAtivo && !Model.PodeGerenciar)
{
    <div class="bfa-admin-notice" role="status">
        Esta unidade possui franqueado responsável. Os Planos locais estão disponíveis para consulta pela Administração da Rede.
    </div>
}
@if (TempData["Sucesso"] is string sucesso)
{
    <div class="bfa-admin-notice" role="status"><strong>@sucesso</strong></div>
}

<section class="bfa-list-toolbar" aria-label="Filtros">
    <nav class="bfa-filter-tabs" aria-label="Filtrar planos por status">
        <a class="bfa-filter-tab @(Model.Filtro == FiltroPlanos.Ativos ? "is-active" : null)" href="@Model.RotaBase?status=ativos">
            Ativos
        </a>
        <a class="bfa-filter-tab @(Model.Filtro == FiltroPlanos.Inativos ? "is-active" : null)" href="@Model.RotaBase?status=inativos">
            Inativos
        </a>
        <a class="bfa-filter-tab @(Model.Filtro == FiltroPlanos.Todos ? "is-active" : null)" href="@Model.RotaBase?status=todos">
            Todos
        </a>
    </nav>
</section>

@if (Model.Planos.Count == 0)
{
    <section class="bfa-admin-empty-state" role="status">
        <div class="bfa-admin-empty-state__symbol" aria-hidden="true">BFA</div>
        <div>
            <h2>@(Model.EhLocal ? "Nenhum plano local cadastrado nesta unidade." : "Nenhum plano da Rede cadastrado.")</h2>
            <p>@(Model.PodeGerenciar ? "Cadastre o primeiro plano e suas condições comerciais." : "Não há planos disponíveis para este filtro.")</p>
            @if (Model.PodeGerenciar)
            {
                <a class="bfa-btn-primary bfa-admin-button" href="@Model.RotaBase/novo">Criar primeiro plano</a>
            }
        </div>
    </section>
}
else
{
    <div class="bfa-data-card bfa-admin-desktop-list">
        <div class="bfa-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Plano</th>
                        <th>Condições atuais</th>
                        <th>Taxa de matrícula</th>
                        <th>Vigência</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var plano in Model.Planos)
                {
                    var versao = plano.VersaoAtual;
                    <tr>
                        <td>
                            <div class="bfa-data-primary">@plano.Nome</div>
                        </td>
                        <td>
                            @if (versao is null)
                            {
                                <span class="bfa-data-secondary">Sem versão aberta</span>
                            }
                            else
                            {
                                <div class="bfa-data-primary">@versao.DuracaoMeses @(versao.DuracaoMeses == 1 ? "mês" : "meses") · @versao.FrequenciaSemanal× por semana</div>
                                <div class="bfa-data-secondary">@versao.ValorMensal.ToString("C", cultura)/mês</div>
                            }
                        </td>
                        <td>@(versao?.CobraMatricula == true ? versao.ValorMatricula!.Value.ToString("C", cultura) : "Não cobra")</td>
                        <td>@(versao is null ? "—" : $"Desde {versao.VigenciaInicio:dd/MM/yyyy}")</td>
                        <td>
                            <span class="bfa-data-badge @(plano.Ativo ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                                <i class="bfa-data-badge__dot"></i>
                                @(plano.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <div class="bfa-actions-cell">
                                <partial name="/Views/Shared/Planos/_Acoes.cshtml" model="@(new BFA.Web.ViewModels.Planos.PlanoAcoesViewModel(plano.Id, plano.Ativo, Model.PodeGerenciar, Model.RotaBase))" />
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="bfa-table-footer">
            @{
                var totalPaginas = (int)Math.Ceiling((double)Model.TotalItens / Model.TamanhoPagina);
                var primeiroIndice = Model.TotalItens == 0 ? 0 : (Model.PaginaAtual - 1) * Model.TamanhoPagina + 1;
                var ultimoIndice = Math.Min(Model.PaginaAtual * Model.TamanhoPagina, Model.TotalItens);
                var filtroValor = Model.Filtro switch
                {
                    FiltroPlanos.Inativos => "inativos",
                    FiltroPlanos.Todos => "todos",
                    _ => "ativos"
                };
                var baseQueryString = $"status={filtroValor}";
                var paginacao = new PaginacaoViewModel
                {
                    PaginaAtual = Model.PaginaAtual,
                    TotalPaginas = totalPaginas,
                    TotalItens = Model.TotalItens,
                    PrimeiroIndice = primeiroIndice,
                    UltimoIndice = ultimoIndice,
                    BaseQueryString = baseQueryString
                };
            }
            <div>Mostrando <strong>@primeiroIndice–@ultimoIndice</strong> de <strong>@Model.TotalItens</strong> planos</div>
            <partial name="_Paginacao" model="paginacao" />
        </div>
    </div>

    <section class="bfa-mobile-card-list" aria-label="@titulo">
        @foreach (var plano in Model.Planos)
        {
            var versao = plano.VersaoAtual;
            <article class="bfa-mobile-card">
                <div class="bfa-mobile-card__head">
                    <div>
                        <div class="bfa-data-primary">@plano.Nome</div>
                    </div>
                    <span class="bfa-data-badge @(plano.Ativo ? "bfa-data-badge--active" : "bfa-data-badge--inactive")">
                        <i class="bfa-data-badge__dot"></i>
                        @(plano.Ativo ? "Ativo" : "Inativo")
                    </span>
                </div>
                <div class="bfa-mobile-card__grid">
                    <div>
                        <span class="bfa-mobile-card__label">Duração</span>
                        <div>@(versao is null ? "—" : $"{versao.DuracaoMeses} {(versao.DuracaoMeses == 1 ? "mês" : "meses")}")</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Frequência</span>
                        <div>@(versao is null ? "—" : $"{versao.FrequenciaSemanal}× por semana")</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Valor mensal</span>
                        <div>@(versao is null ? "—" : versao.ValorMensal.ToString("C", cultura))</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Taxa de matrícula</span>
                        <div>@(versao?.CobraMatricula == true ? versao.ValorMatricula!.Value.ToString("C", cultura) : "Não cobra")</div>
                    </div>
                    <div>
                        <span class="bfa-mobile-card__label">Vigência atual</span>
                        <div>@(versao is null ? "Sem versão aberta" : $"Desde {versao.VigenciaInicio:dd/MM/yyyy}")</div>
                    </div>
                </div>
                <div class="bfa-mobile-card__actions">
                    <partial name="/Views/Shared/Planos/_Acoes.cshtml" model="@(new BFA.Web.ViewModels.Planos.PlanoAcoesViewModel(plano.Id, plano.Ativo, Model.PodeGerenciar, Model.RotaBase))" />
                </div>
            </article>
        }
    </section>
}
