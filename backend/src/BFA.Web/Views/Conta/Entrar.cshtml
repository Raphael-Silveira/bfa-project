@model BFA.Web.ViewModels.Conta.LoginViewModel
@{
    ViewData["Title"] = "Entrar";
    Layout = "_AuthLayout";
}

<section class="bfa-auth-card" aria-labelledby="login-title">
    <img class="bfa-auth-logo"
         src="~/images/brand/bfa-logo-principal-dark.png"
         alt="Brazilian Footvolley Academy" />

    <div class="bfa-auth-heading">
        <h1 id="login-title" class="bfa-auth-title">Entrar</h1>
        <p class="bfa-auth-subtitle">Acesse sua conta BFA.</p>
    </div>

    @if (TempData[nameof(BFA.Web.Controllers.PrimeiroAcessoController.MensagemSenhaDefinida)] is string mensagem)
    {
        <p class="bfa-auth-success" role="status">@mensagem</p>
    }

    <form asp-controller="Conta" asp-action="Entrar" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="ReturnUrl" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="bfa-validation-message" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Email" class="bfa-form-label"></label>
            <input asp-for="Email"
                   class="form-control bfa-form-control"
                   autocomplete="username"
                   inputmode="text" />
            <span asp-validation-for="Email" class="bfa-validation-message"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Senha" class="bfa-form-label"></label>
            <input asp-for="Senha"
                   class="form-control bfa-form-control"
                   autocomplete="current-password" />
            <span asp-validation-for="Senha" class="bfa-validation-message"></span>
        </div>

        <div class="form-check bfa-auth-remember">
            <input asp-for="LembrarMe" class="form-check-input" />
            <label asp-for="LembrarMe" class="form-check-label"></label>
        </div>

        <button class="bfa-btn-primary bfa-auth-submit" type="submit">Entrar</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
