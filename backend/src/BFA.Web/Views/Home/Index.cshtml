@{
    ViewData["Title"] = "Início";
}

<div class="text-center">
    <h1 class="display-4">Brazilian Footvolley Academy</h1>
    <p class="lead">Fundação técnica da BFA Platform.</p>

    <div class="mt-4">
        @if (User.Identity?.IsAuthenticated == true)
