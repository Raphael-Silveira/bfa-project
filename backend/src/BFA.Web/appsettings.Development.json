{
  "Hangfire": {
    "Enabled": true
  },
  "Armazenamento": {
    "Documentos": {
      "DiretorioBase": ".storage",
      "TamanhoMaximoBytes": 20971520
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "BFA": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "IncludeScopes": true
    }
  }
}